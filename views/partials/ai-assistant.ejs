<!-- Floating Gemini AI Assistant Chat Widget -->
<div id="aiAssistantWidget" class="ai-assistant-widget">
    <!-- Floating Circular Toggle Button -->
    <button id="aiChatToggle" class="ai-chat-toggle" aria-label="Toggle AI Assistant">
        <i class="fas fa-sparkles text-copper"></i>
        <i class="fas fa-times text-copper close-icon d-none"></i>
        <span class="ai-pulse-ring"></span>
    </button>

    <!-- Expanded Glassmorphism Chat Panel -->
    <div id="aiChatPanel" class="ai-chat-panel d-none">
        <!-- Panel Header -->
        <div class="ai-chat-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="ai-avatar-badge">
                    <i class="fas fa-robot"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold font-display text-white">Campus AI Reunifier</h6>
                    <small class="text-copper">Powered by Gemini 2.0</small>
                </div>
            </div>
            <button id="aiChatClose" class="btn-close btn-close-white btn-sm" aria-label="Close"></button>
        </div>

        <!-- Chat Messages Container -->
        <div id="aiChatMessages" class="ai-chat-messages">
            <div class="ai-message bot-message">
                <div class="message-content">
                    <p class="mb-1">Hello! I am your AI Lost & Found assistant.</p>
                    <p class="mb-0 small text-muted">Describe what you lost or found in plain words, and I'll match it across our campus database!</p>
                </div>
            </div>

            <!-- Suggestion Chips -->
            <div class="ai-suggestion-chips mt-2">
                <button class="chip-btn" onclick="sendSuggestion('I lost a black leather wallet near library')">Black leather wallet</button>
                <button class="chip-btn" onclick="sendSuggestion('Found blue keys with a silver lanyard')">Blue keys with lanyard</button>
                <button class="chip-btn" onclick="sendSuggestion('Lost an Apple AirPods Pro case')">AirPods Pro case</button>
            </div>
        </div>

        <!-- Panel Input Form -->
        <form id="aiChatForm" class="ai-chat-input-form">
            <div class="input-group">
                <input type="text" id="aiChatInput" class="form-control" placeholder="Type item description..." required autocomplete="off">
                <button type="submit" id="aiChatSubmitBtn" class="btn btn-copper">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
.ai-assistant-widget {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1050;
    font-family: var(--font-sans);
}

.ai-chat-toggle {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgba(20, 21, 26, 0.9);
    border: 1px solid rgba(201, 138, 75, 0.5);
    color: #e0a85c;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6), 0 0 20px rgba(201, 138, 75, 0.35);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    position: relative;
}

.ai-chat-toggle:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.8), 0 0 30px rgba(201, 138, 75, 0.6);
}

.ai-pulse-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid rgba(201, 138, 75, 0.4);
    animation: aiPulse 2.5s ease-out infinite;
    pointer-events: none;
}

@keyframes aiPulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    100% { transform: scale(1.25); opacity: 0; }
}

.ai-chat-panel {
    position: absolute;
    bottom: 72px;
    right: 0;
    width: 360px;
    max-width: calc(100vw - 32px);
    height: 480px;
    background: rgba(15, 16, 21, 0.92);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border: 1px solid rgba(201, 138, 75, 0.35);
    border-radius: 18px;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.85), 0 0 25px rgba(201, 138, 75, 0.2);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: chatExpand 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes chatExpand {
    from { opacity: 0; transform: scale(0.9) translateY(20px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
}

.ai-chat-header {
    padding: 14px 16px;
    background: rgba(20, 21, 26, 0.8);
    border-bottom: 1px solid rgba(201, 138, 75, 0.2);
}

.ai-avatar-badge {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #c98a4b, #a26a33);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    box-shadow: 0 0 10px rgba(201, 138, 75, 0.4);
}

.ai-chat-messages {
    flex: 1;
    padding: 14px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.ai-message {
    max-width: 85%;
    display: flex;
    flex-direction: column;
}

.ai-message.bot-message {
    align-self: flex-start;
}

.ai-message.user-message {
    align-self: flex-end;
}

.ai-message .message-content {
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 0.875rem;
    line-height: 1.45;
}

.bot-message .message-content {
    background: rgba(30, 32, 42, 0.85);
    border: 1px solid rgba(201, 138, 75, 0.2);
    color: #e2e8f0;
    border-top-left-radius: 4px;
}

.user-message .message-content {
    background: linear-gradient(135deg, #c98a4b, #a26a33);
    color: #ffffff;
    border-top-right-radius: 4px;
}

.ai-match-card-mini {
    background: rgba(20, 21, 26, 0.9);
    border: 1px solid rgba(201, 138, 75, 0.3);
    border-radius: 10px;
    padding: 8px 10px;
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s ease, border-color 0.2s ease;
}

.ai-match-card-mini:hover {
    background: rgba(201, 138, 75, 0.15);
    border-color: #e0a85c;
    color: inherit;
}

.ai-match-thumb {
    width: 42px;
    height: 42px;
    border-radius: 6px;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.05);
}

.ai-suggestion-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.chip-btn {
    background: rgba(201, 138, 75, 0.12);
    border: 1px solid rgba(201, 138, 75, 0.3);
    color: #e0a85c;
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.chip-btn:hover {
    background: var(--copper);
    color: #fff;
}

.ai-chat-input-form {
    padding: 10px;
    background: rgba(20, 21, 26, 0.9);
    border-top: 1px solid rgba(201, 138, 75, 0.2);
}

.ai-chat-input-form .form-control {
    background: rgba(11, 12, 16, 0.8);
    border: 1px solid rgba(201, 138, 75, 0.3);
    color: #fff;
    font-size: 0.85rem;
}

.ai-chat-input-form .form-control:focus {
    border-color: var(--copper);
    box-shadow: 0 0 10px rgba(201, 138, 75, 0.25);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('aiChatToggle');
    const closeBtn = document.getElementById('aiChatClose');
    const panel = document.getElementById('aiChatPanel');
    const form = document.getElementById('aiChatForm');
    const input = document.getElementById('aiChatInput');
    const messagesContainer = document.getElementById('aiChatMessages');
    const sparkleIcon = toggleBtn?.querySelector('.fa-sparkles');
    const closeIcon = toggleBtn?.querySelector('.close-icon');

    const togglePanel = () => {
        const isHidden = panel.classList.contains('d-none');
        if (isHidden) {
            panel.classList.remove('d-none');
            sparkleIcon?.classList.add('d-none');
            closeIcon?.classList.remove('d-none');
            input?.focus();
        } else {
            panel.classList.add('d-none');
            sparkleIcon?.classList.remove('d-none');
            closeIcon?.classList.add('d-none');
        }
    };

    toggleBtn?.addEventListener('click', togglePanel);
    closeBtn?.addEventListener('click', togglePanel);

    window.sendSuggestion = function(text) {
        if (input) {
            input.value = text;
            form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
    };

    form?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const userText = input.value.trim();
        if (!userText) return;

        // Render user message
        const userMsgDiv = document.createElement('div');
        userMsgDiv.className = 'ai-message user-message';
        userMsgDiv.innerHTML = `<div class="message-content"><p class="mb-0">${escapeHtml(userText)}</p></div>`;
        messagesContainer.appendChild(userMsgDiv);
        input.value = '';
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        // Render typing indicator
        const loadingDiv = document.createElement('div');
        loadingDiv.className = 'ai-message bot-message loading-msg';
        loadingDiv.innerHTML = `<div class="message-content"><i class="fas fa-spinner fa-spin me-2 text-copper"></i>Searching items with Gemini...</div>`;
        messagesContainer.appendChild(loadingDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        try {
            const res = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: userText })
            });
            const data = await res.json();

            messagesContainer.removeChild(loadingDiv);

            const botMsgDiv = document.createElement('div');
            botMsgDiv.className = 'ai-message bot-message';

            let matchesHtml = '';
            if (data.matches && data.matches.length > 0) {
                matchesHtml = '<div class="mt-2">';
                data.matches.forEach(m => {
                    matchesHtml += `
                        <a href="/items/${m._id}" class="ai-match-card-mini">
                            ${m.imagePath ? `<img src="${m.imagePath}" class="ai-match-thumb" alt="${escapeHtml(m.itemName)}">` : `<div class="ai-match-thumb d-flex align-items-center justify-content-center bg-dark text-copper"><i class="fas fa-box"></i></div>`}
                            <div class="overflow-hidden flex-grow-1">
                                <div class="fw-bold text-truncate text-white small">${escapeHtml(m.itemName)}</div>
                                <div class="small text-muted text-truncate"><i class="fas fa-map-marker-alt me-1"></i>${escapeHtml(m.location)}</div>
                            </div>
                            <span class="badge bg-${m.type === 'lost' ? 'danger' : 'success'}">${m.type}</span>
                        </a>
                    `;
                });
                matchesHtml += '</div>';
            } else {
                matchesHtml = '<p class="small text-muted mt-1 mb-0">No direct database matches found. Try broadening your keywords!</p>';
            }

            botMsgDiv.innerHTML = `
                <div class="message-content">
                    <p class="mb-1">${escapeHtml(data.response || 'Here are the candidate matches:')}</p>
                    ${matchesHtml}
                </div>
            `;

            messagesContainer.appendChild(botMsgDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

        } catch (err) {
            console.error('Chat submit error:', err);
            if (loadingDiv.parentNode) messagesContainer.removeChild(loadingDiv);

            const errDiv = document.createElement('div');
            errDiv.className = 'ai-message bot-message';
            errDiv.innerHTML = `<div class="message-content"><p class="mb-0 text-danger">Sorry, unable to connect right now. Please try again.</p></div>`;
            messagesContainer.appendChild(errDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    });

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
});
</script>
