<!-- Floating Gemini AI Assistant Chat Widget -->
<div id="aiAssistantWidget" class="ai-assistant-widget">
    <!-- Floating Circular Toggle Button & Non-Obstructing Hint Pill -->
    <div class="d-flex align-items-center gap-2">
        <div class="ai-toggle-pill d-none d-sm-flex align-items-center gap-1 shadow" id="aiTogglePill">
            <span class="pulse-dot"></span>
            <span>Ask Campus AI</span>
        </div>
        <button id="aiChatToggle" class="ai-chat-toggle" aria-label="Toggle Campus AI Assistant" title="Campus Lost & Found AI Assistant" type="button">
            <img src="/images/ai-logo.jpg?v=<%= Date.now() %>" alt="Campus AI Assistant" class="ai-toggle-logo-img" id="aiToggleLogoImg" style="width: 100%; height: 100%; max-width: 60px; max-height: 60px; border-radius: 50%; object-fit: cover; display: block;">
            <i class="fas fa-times text-white close-icon d-none" id="aiToggleCloseIcon"></i>
            <span class="ai-pulse-ring"></span>
            <span class="ai-online-dot"></span>
        </button>
    </div>

    <!-- Expanded Glassmorphism Chat Panel -->
    <div id="aiChatPanel" class="ai-chat-panel d-none">
        <!-- Panel Header -->
        <div class="ai-chat-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <img src="/images/ai-logo.jpg?v=<%= Date.now() %>" alt="AI Avatar" class="ai-avatar-badge-img" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover;">
                <div>
                    <h6 class="mb-0 fw-bold font-sans text-white">Campus AI Assistant</h6>
                    <small class="text-cyan"><i class="fas fa-circle text-success me-1 style-dot"></i> Online • Powered by Gemini AI</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1">
                <button type="button" id="aiChatReset" class="btn btn-sm text-cyan p-1 text-decoration-none" title="Reset Chat / New Search">
                    <i class="fas fa-redo-alt" style="font-size: 0.8rem;"></i>
                </button>
                <button type="button" id="aiChatClose" class="btn-close btn-close-white btn-sm ms-1" aria-label="Close"></button>
            </div>
        </div>

        <!-- Chat Messages Container -->
        <div id="aiChatMessages" class="ai-chat-messages">
            <div class="ai-message bot-message">
                <div class="message-content">
                    <p class="mb-1 fw-semibold ai-welcome-title">👋 Hi! I'm your Campus Lost & Found Assistant.</p>
                    <p class="mb-0 small text-light-gray">Describe an item you lost or found (brand, color, location), or ask me how to claim a match!</p>
                </div>
            </div>

            <!-- Suggestion Chips -->
            <div class="ai-suggestion-chips mt-2">
                <button type="button" class="chip-btn" onclick="sendSuggestion('I lost a black leather wallet near library')">🔍 Lost black leather wallet</button>
                <button type="button" class="chip-btn" onclick="sendSuggestion('Found blue keys with silver lanyard')">📦 Found blue keys</button>
                <button type="button" class="chip-btn" onclick="sendSuggestion('How does AI visual matching work?')">⚡ How AI matching works</button>
            </div>
        </div>

        <!-- Attached Photo Preview Container -->
        <div id="aiImagePreviewBar" class="ai-image-preview-bar d-none">
            <div class="position-relative d-inline-block">
                <img id="aiImagePreview" src="" alt="Item photo preview" class="ai-image-preview-thumb">
                <button type="button" id="aiRemoveImageBtn" class="btn-remove-preview" title="Remove photo">&times;</button>
            </div>
            <span class="small text-cyan ms-2"><i class="fas fa-image me-1"></i> Photo attached</span>
        </div>

        <!-- Panel Input Form -->
        <form id="aiChatForm" class="ai-chat-input-form" enctype="multipart/form-data">
            <input type="file" id="aiImageInput" accept="image/*" class="d-none">
            <div class="input-group">
                <button type="button" id="aiImageBtn" class="btn btn-outline-cyan" title="Attach picture of lost/found item">
                    <i class="fas fa-camera"></i>
                </button>
                <input type="text" id="aiChatInput" class="form-control" placeholder="Describe or attach item photo..." autocomplete="off">
                <button type="submit" id="aiChatSubmitBtn" class="btn btn-primary">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </form>
    </div>
</div>

