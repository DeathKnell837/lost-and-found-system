<!-- Floating Gemini AI Assistant Chat Widget -->
<div id="aiAssistantWidget" class="ai-assistant-widget">
    <!-- Floating Circular Toggle Button -->
    <button id="aiChatToggle" class="ai-chat-toggle" aria-label="Toggle Lost & Found AI Assistant" title="Campus Lost & Found AI Assistant">
        <i class="fas fa-search-location text-cyan"></i>
        <i class="fas fa-times text-white close-icon d-none"></i>
        <span class="ai-pulse-ring"></span>
        <span class="ai-online-dot"></span>
        <span class="ai-badge-label">AI Finder</span>
    </button>

    <!-- Expanded Glassmorphism Chat Panel -->
    <div id="aiChatPanel" class="ai-chat-panel d-none">
        <!-- Panel Header -->
        <div class="ai-chat-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="ai-avatar-badge">
                    <i class="fas fa-robot"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold font-sans text-white">Lost & Found AI Assistant</h6>
                    <small class="text-cyan"><i class="fas fa-circle text-success me-1 style-dot"></i> Online • Powered by Gemini AI</small>
                </div>
            </div>
            <button id="aiChatClose" class="btn-close btn-close-white btn-sm" aria-label="Close"></button>
        </div>

        <!-- Chat Messages Container -->
        <div id="aiChatMessages" class="ai-chat-messages">
            <div class="ai-message bot-message">
                <div class="message-content">
                    <p class="mb-1 fw-semibold text-white">👋 Hi! I'm your Campus Lost & Found Assistant.</p>
                    <p class="mb-0 small text-light-gray">Describe an item you lost or found (brand, color, location), or ask me how to claim a match!</p>
                </div>
            </div>

            <!-- Suggestion Chips -->
            <div class="ai-suggestion-chips mt-2">
                <button class="chip-btn" onclick="sendSuggestion('I lost a black leather wallet near library')">🔍 Lost black leather wallet</button>
                <button class="chip-btn" onclick="sendSuggestion('Found blue keys with silver lanyard')">📦 Found blue keys</button>
                <button class="chip-btn" onclick="sendSuggestion('How does AI visual matching work?')">⚡ How AI matching works</button>
            </div>
        </div>

        <!-- Attached Photo Preview Container -->
        <div id="aiImagePreviewBar" class="ai-image-preview-bar d-none">
            <div class="position-relative d-inline-block">
                <img id="aiImagePreview" src="" alt="Item photo preview" class="ai-image-preview-thumb">
                <button type="button" id="aiRemoveImageBtn" class="btn-remove-preview" title="Remove photo">&times;</button>
            </div>
            <span class="small text-cyan ms-2"><i class="fas fa-image me-1"></i> Photo attached</span>
        </div>

        <!-- Panel Input Form -->
        <form id="aiChatForm" class="ai-chat-input-form" enctype="multipart/form-data">
            <input type="file" id="aiImageInput" accept="image/*" class="d-none">
            <div class="input-group">
                <button type="button" id="aiImageBtn" class="btn btn-outline-cyan" title="Attach picture of lost/found item">
                    <i class="fas fa-camera"></i>
                </button>
                <input type="text" id="aiChatInput" class="form-control" placeholder="Describe or attach item photo..." autocomplete="off">
                <button type="submit" id="aiChatSubmitBtn" class="btn btn-primary">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<style>
.ai-assistant-widget {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 1050;
    font-family: var(--font-sans);
}

.text-cyan {
    color: #06b6d4 !important;
}

.style-dot {
    font-size: 0.5rem;
    vertical-align: middle;
}

.text-light-gray {
    color: #cbd5e1 !important;
}

.btn-outline-cyan {
    background: rgba(6, 182, 212, 0.15);
    border: 1px solid rgba(6, 182, 212, 0.4);
    color: #38bdf8;
    transition: all 0.2s ease;
}

.btn-outline-cyan:hover {
    background: #06b6d4;
    color: #ffffff;
    box-shadow: 0 0 12px rgba(6, 182, 212, 0.5);
}

.ai-image-preview-bar {
    padding: 8px 14px;
    background: rgba(15, 23, 42, 0.95);
    border-top: 1px solid rgba(59, 130, 246, 0.2);
    display: flex;
    align-items: center;
}

.ai-image-preview-thumb {
    width: 46px;
    height: 46px;
    border-radius: 8px;
    object-fit: cover;
    border: 1.5px solid #06b6d4;
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.4);
}

.btn-remove-preview {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #ef4444;
    color: #ffffff;
    border: 1px solid #0f172a;
    font-size: 0.75rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.user-uploaded-img {
    max-width: 180px;
    max-height: 140px;
    border-radius: 10px;
    margin-bottom: 6px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    object-fit: cover;
}

.ai-chat-toggle {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.95);
    border: 1.5px solid rgba(59, 130, 246, 0.6);
    color: #3b82f6;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7), 0 0 25px rgba(59, 130, 246, 0.5);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    position: relative;
}

.ai-online-dot {
    position: absolute;
    bottom: 2px;
    right: 4px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #10b981;
    border: 2px solid #0f172a;
    box-shadow: 0 0 8px #10b981;
}

.ai-badge-label {
    position: absolute;
    top: -6px;
    right: -6px;
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 10px;
    border: 1px solid #0f172a;
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.7);
}

.ai-chat-toggle:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.8), 0 0 40px rgba(59, 130, 246, 0.75);
}

.ai-pulse-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid rgba(59, 130, 246, 0.5);
    animation: aiPulse 2.5s ease-out infinite;
    pointer-events: none;
}

@keyframes aiPulse {
    0% { transform: scale(0.95); opacity: 0.85; }
    100% { transform: scale(1.3); opacity: 0; }
}

.ai-chat-panel {
    position: absolute;
    bottom: 78px;
    right: 0;
    width: 385px;
    max-width: calc(100vw - 32px);
    height: 520px;
    background: rgba(15, 23, 42, 0.96);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 35px rgba(59, 130, 246, 0.25);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: chatExpand 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes chatExpand {
    from { opacity: 0; transform: scale(0.9) translateY(20px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
}

.ai-chat-header {
    padding: 14px 16px;
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid rgba(59, 130, 246, 0.25);
}

.ai-chat-header h6 {
    color: #ffffff !important;
    font-size: 0.95rem;
}

.ai-avatar-badge {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    box-shadow: 0 0 14px rgba(59, 130, 246, 0.6);
}

.ai-chat-messages {
    flex: 1;
    padding: 14px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.ai-message {
    max-width: 88%;
    display: flex;
    flex-direction: column;
}

.ai-message.bot-message {
    align-self: flex-start;
}

.ai-message.user-message {
    align-self: flex-end;
}

.ai-message .message-content {
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 0.88rem;
    line-height: 1.5;
}

.bot-message .message-content {
    background: rgba(30, 41, 59, 0.85);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-left: 3px solid #3b82f6;
    color: #f8fafc;
    border-top-left-radius: 4px;
}

.user-message .message-content {
    background: linear-gradient(135deg, #3b82f6, #0284c7);
    color: #ffffff;
    border-top-right-radius: 4px;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.ai-match-card-mini {
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 12px;
    padding: 10px 12px;
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #f8fafc;
    transition: background 0.2s ease, border-color 0.2s ease;
}

.ai-match-card-mini:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: #60a5fa;
    color: #ffffff;
}

.ai-match-thumb {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.05);
}

.ai-suggestion-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.chip-btn {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.35);
    color: #60a5fa;
    font-size: 0.75rem;
    padding: 6px 12px;
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.chip-btn:hover {
    background: linear-gradient(135deg, #3b82f6, #06b6d4);
    color: #ffffff;
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.4);
}

.ai-chat-input-form {
    padding: 10px 12px;
    background: rgba(15, 23, 42, 0.95);
    border-top: 1px solid rgba(59, 130, 246, 0.25);
}

.ai-chat-input-form .form-control {
    background: rgba(11, 12, 16, 0.8);
    border: 1px solid rgba(201, 138, 75, 0.3);
    color: #fff;
    font-size: 0.85rem;
}

.ai-chat-input-form .form-control:focus {
    border-color: var(--copper);
    box-shadow: 0 0 10px rgba(201, 138, 75, 0.25);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('aiChatToggle');
    const closeBtn = document.getElementById('aiChatClose');
    const chatPanel = document.getElementById('aiChatPanel');
    const chatForm = document.getElementById('aiChatForm');
    const chatInput = document.getElementById('aiChatInput');
    const messagesContainer = document.getElementById('aiChatMessages');
    const openIcon = toggleBtn.querySelector('.fa-search-location, .fa-robot');
    const closeIcon = toggleBtn.querySelector('.close-icon');

    const imageBtn = document.getElementById('aiImageBtn');
    const imageInput = document.getElementById('aiImageInput');
    const previewBar = document.getElementById('aiImagePreviewBar');
    const previewImg = document.getElementById('aiImagePreview');
    const removeImgBtn = document.getElementById('aiRemoveImageBtn');

    let selectedFile = null;

    if (imageBtn && imageInput) {
        imageBtn.addEventListener('click', () => imageInput.click());

        imageInput.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) {
                selectedFile = e.target.files[0];
                const reader = new FileReader();
                reader.onload = (evt) => {
                    previewImg.src = evt.target.result;
                    previewBar.classList.remove('d-none');
                };
                reader.readAsDataURL(selectedFile);
            }
        });

        removeImgBtn.addEventListener('click', () => {
            selectedFile = null;
            imageInput.value = '';
            previewBar.classList.add('d-none');
            previewImg.src = '';
        });
    }

    // Toggle Chat Panel
    function toggleChat() {
        const isHidden = chatPanel.classList.contains('d-none');
        if (isHidden) {
            chatPanel.classList.remove('d-none');
            if (openIcon) openIcon.classList.add('d-none');
            if (closeIcon) closeIcon.classList.remove('d-none');
            chatInput.focus();
        } else {
            chatPanel.classList.add('d-none');
            if (openIcon) openIcon.classList.remove('d-none');
            if (closeIcon) closeIcon.classList.add('d-none');
        }
    }

    toggleBtn.addEventListener('click', toggleChat);
    closeBtn.addEventListener('click', toggleChat);

    // Global Suggestion Function
    window.sendSuggestion = function(text) {
        chatInput.value = text;
        chatForm.dispatchEvent(new Event('submit'));
    };

    // Handle Chat Submit
    chatForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const userText = chatInput.value.trim();
        const fileToSend = selectedFile;

        if (!userText && !fileToSend) return;

        // Render user message bubble with text and optional image preview
        const userMsgDiv = document.createElement('div');
        userMsgDiv.className = 'ai-message user-message';
        
        let userContentHtml = '<div class="message-content">';
        if (fileToSend && previewImg.src) {
            userContentHtml += `<img src="${previewImg.src}" class="user-uploaded-img d-block" alt="Uploaded Item">`;
        }
        if (userText) {
            userContentHtml += `<p class="mb-0">${escapeHtml(userText)}</p>`;
        }
        userContentHtml += '</div>';
        
        userMsgDiv.innerHTML = userContentHtml;
        messagesContainer.appendChild(userMsgDiv);

        // Reset input and file preview bar
        chatInput.value = '';
        selectedFile = null;
        if (imageInput) imageInput.value = '';
        if (previewBar) previewBar.classList.add('d-none');
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        // Render dynamic typing indicator
        const isImageOrItemSearch = fileToSend || /lost|found|wallet|keys|phone|bag|jacket|airpod|laptop|umbrella|id|card|book|badge/i.test(userText);
        const loadingText = fileToSend 
            ? '<i class="fas fa-camera fa-spin me-2 text-cyan"></i>Analyzing photo with Gemini Vision AI...' 
            : (isImageOrItemSearch 
                ? '<i class="fas fa-search-location fa-spin me-2 text-cyan"></i>Scanning campus database for matches...' 
                : '<i class="fas fa-sparkles fa-spin me-2 text-cyan"></i>Gemini AI is thinking...');

        const loadingDiv = document.createElement('div');
        loadingDiv.className = 'ai-message bot-message loading-msg';
        loadingDiv.innerHTML = `<div class="message-content">${loadingText}</div>`;
        messagesContainer.appendChild(loadingDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        try {
            const formData = new FormData();
            if (userText) formData.append('message', userText);
            if (fileToSend) formData.append('image', fileToSend);

            const res = await fetch('/api/chat', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();

            messagesContainer.removeChild(loadingDiv);

            const botMsgDiv = document.createElement('div');
            botMsgDiv.className = 'ai-message bot-message';

            let matchesHtml = '';
            if (data.matches && data.matches.length > 0) {
                matchesHtml = '<div class="mt-2">';
                data.matches.forEach(m => {
                    matchesHtml += `
                        <a href="/items/${m._id}" class="ai-match-card-mini">
                            ${m.imagePath ? `<img src="${m.imagePath}" class="ai-match-thumb" alt="${escapeHtml(m.itemName)}">` : `<div class="ai-match-thumb d-flex align-items-center justify-content-center bg-dark text-cyan"><i class="fas fa-box"></i></div>`}
                            <div class="overflow-hidden flex-grow-1">
                                <div class="fw-bold text-truncate text-white small">${escapeHtml(m.itemName)}</div>
                                <div class="small text-muted text-truncate"><i class="fas fa-map-marker-alt me-1"></i>${escapeHtml(m.location)}</div>
                            </div>
                            <span class="badge bg-${m.type === 'lost' ? 'danger' : 'success'}">${m.type}</span>
                        </a>
                    `;
                });
                matchesHtml += '</div>';
            } else if (data.isSearch === true) {
                matchesHtml = '<p class="small text-muted mt-1 mb-0"><i class="fas fa-search me-1 text-cyan"></i> No direct database matches found yet.</p>';
            }

            botMsgDiv.innerHTML = `
                <div class="message-content">
                    <p class="mb-1">${escapeHtml(data.response || 'Here are the candidate matches:')}</p>
                    ${matchesHtml}
                </div>
            `;

            messagesContainer.appendChild(botMsgDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

        } catch (err) {
            console.error('Chat submit error:', err);
            if (loadingDiv.parentNode) messagesContainer.removeChild(loadingDiv);

            const errDiv = document.createElement('div');
            errDiv.className = 'ai-message bot-message';
            errDiv.innerHTML = `<div class="message-content"><p class="mb-0 text-white">Hello! I am your Campus Lost & Found Assistant. How can I help you find or report a lost item on campus today?</p></div>`;
            messagesContainer.appendChild(errDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    });

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
});
</script>
