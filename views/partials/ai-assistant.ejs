<script>
document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('aiChatToggle');
    const togglePill = document.getElementById('aiTogglePill');
    const closeBtn = document.getElementById('aiChatClose');
    const chatPanel = document.getElementById('aiChatPanel');
    const chatForm = document.getElementById('aiChatForm');
    const chatInput = document.getElementById('aiChatInput');
    const messagesContainer = document.getElementById('aiChatMessages');
    const logoImg = document.getElementById('aiToggleLogoImg');
    const closeIcon = document.getElementById('aiToggleCloseIcon');

    const imageBtn = document.getElementById('aiImageBtn');
    const imageInput = document.getElementById('aiImageInput');
    const previewBar = document.getElementById('aiImagePreviewBar');
    const previewImg = document.getElementById('aiImagePreview');
    const removeImgBtn = document.getElementById('aiRemoveImageBtn');
    const resetBtn = document.getElementById('aiChatReset');

    let selectedFile = null;
    let conversationMemory = [];

    const widget = document.getElementById('aiAssistantWidget');

    function openChat() {
        if (!chatPanel) return;
        chatPanel.classList.remove('d-none');
        if (widget) widget.classList.add('chat-open');
        if (logoImg) logoImg.classList.add('d-none');
        if (closeIcon) closeIcon.classList.remove('d-none');
        if (togglePill) togglePill.classList.add('d-none');
        setTimeout(() => { if (chatInput) chatInput.focus(); }, 80);
    }

    function closeChat() {
        if (!chatPanel) return;
        chatPanel.classList.add('d-none');
        if (widget) widget.classList.remove('chat-open');
        if (logoImg) logoImg.classList.remove('d-none');
        if (closeIcon) closeIcon.classList.add('d-none');
        if (togglePill) togglePill.classList.remove('d-none');
    }

    function toggleChat(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        if (!chatPanel) return;
        if (chatPanel.classList.contains('d-none')) {
            openChat();
        } else {
            closeChat();
        }
    }

    if (toggleBtn) toggleBtn.addEventListener('click', toggleChat);
    if (togglePill) togglePill.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openChat();
    });
    if (closeBtn) closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeChat();
    });

    if (imageBtn && imageInput) {
        imageBtn.addEventListener('click', (e) => {
            e.preventDefault();
            imageInput.click();
        });

        imageInput.addEventListener('change', (e) => {
            if (e.target.files && e.target.files[0]) {
                selectedFile = e.target.files[0];
                const reader = new FileReader();
                reader.onload = (evt) => {
                    previewImg.src = evt.target.result;
                    previewBar.classList.remove('d-none');
                };
                reader.readAsDataURL(selectedFile);
            }
        });

        if (removeImgBtn) {
            removeImgBtn.addEventListener('click', (e) => {
                e.preventDefault();
                selectedFile = null;
                imageInput.value = '';
                previewBar.classList.add('d-none');
                previewImg.src = '';
            });
        }
    }

    // Reset Chat functionality
    if (resetBtn) {
        resetBtn.addEventListener('click', (e) => {
            e.preventDefault();
            conversationMemory = [];
            messagesContainer.innerHTML = `
                <div class="ai-message bot-message">
                    <div class="message-content">
                        <p class="mb-1 fw-semibold ai-welcome-title">👋 Hi! I'm your Campus Lost & Found Assistant.</p>
                        <p class="mb-0 small text-light-gray">Describe an item you lost or found (brand, color, location), or ask me how to claim a match!</p>
                    </div>
                </div>
                <div class="ai-suggestion-chips mt-2">
                    <button type="button" class="chip-btn" onclick="sendSuggestion('I lost a black leather wallet near library')">🔍 Lost black leather wallet</button>
                    <button type="button" class="chip-btn" onclick="sendSuggestion('Found blue keys with silver lanyard')">📦 Found blue keys</button>
                    <button type="button" class="chip-btn" onclick="sendSuggestion('How does AI visual matching work?')">⚡ How AI matching works</button>
                </div>
            `;
            chatInput.value = '';
            selectedFile = null;
            if (imageInput) imageInput.value = '';
            if (previewBar) previewBar.classList.add('d-none');
            messagesContainer.scrollTop = 0;
        });
    }

    // Global Suggestion Function
    window.sendSuggestion = function(text) {
        if (!chatInput || !chatForm) return;
        chatInput.value = text;
        chatForm.dispatchEvent(new Event('submit'));
    };

    // Handle Chat Submit
    chatForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const userText = chatInput.value.trim();
        const fileToSend = selectedFile;

        if (!userText && !fileToSend) return;

        // Render user message bubble with text and optional image preview
        const userMsgDiv = document.createElement('div');
        userMsgDiv.className = 'ai-message user-message';
        
        let userContentHtml = '<div class="message-content">';
        if (fileToSend && previewImg.src) {
            userContentHtml += `<img src="${previewImg.src}" class="user-uploaded-img d-block" alt="Uploaded Item">`;
        }
        if (userText) {
            userContentHtml += `<p class="mb-0">${escapeHtml(userText)}</p>`;
        }
        userContentHtml += '</div>';
        
        userMsgDiv.innerHTML = userContentHtml;
        messagesContainer.appendChild(userMsgDiv);

        if (userText) {
            conversationMemory.push({ role: 'user', content: userText });
        }

        // Reset input and file preview bar
        chatInput.value = '';
        selectedFile = null;
        if (imageInput) imageInput.value = '';
        if (previewBar) previewBar.classList.add('d-none');
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        // Render dynamic typing indicator
        const isImageOrItemSearch = fileToSend || /lost|found|wallet|keys|phone|bag|jacket|airpod|laptop|umbrella|id|card|book|badge/i.test(userText);
        const loadingText = fileToSend 
            ? '<i class="fas fa-camera fa-spin me-2 text-cyan"></i>Analyzing photo with Gemini Vision AI...' 
            : (isImageOrItemSearch 
                ? '<i class="fas fa-search-location fa-spin me-2 text-cyan"></i>Scanning campus database for matches...' 
                : '<i class="fas fa-sparkles fa-spin me-2 text-cyan"></i>Gemini AI is thinking...');

        const loadingDiv = document.createElement('div');
        loadingDiv.className = 'ai-message bot-message loading-msg';
        loadingDiv.innerHTML = `<div class="message-content">${loadingText}</div>`;
        messagesContainer.appendChild(loadingDiv);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;

        try {
            const formData = new FormData();
            if (userText) formData.append('message', userText);
            if (fileToSend) formData.append('image', fileToSend);
            formData.append('history', JSON.stringify(conversationMemory.slice(-10)));

            const res = await fetch('/api/chat', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();

            messagesContainer.removeChild(loadingDiv);

            const botMsgDiv = document.createElement('div');
            botMsgDiv.className = 'ai-message bot-message';

            let matchesHtml = '';
            if (data.matches && data.matches.length > 0) {
                matchesHtml = '<div class="mt-2">';
                data.matches.forEach(m => {
                    const isFound = m.type === 'found';
                    matchesHtml += `
                        <a href="/items/${m._id}" class="ai-match-card-mini" title="${isFound ? 'Found Item - Click to View & Claim' : 'Reported Lost Item'}">
                            ${m.imagePath ? `<img src="${m.imagePath}" class="ai-match-thumb" alt="${escapeHtml(m.itemName)}">` : `<div class="ai-match-thumb d-flex align-items-center justify-content-center bg-dark text-cyan"><i class="fas fa-box"></i></div>`}
                            <div class="overflow-hidden flex-grow-1">
                                <div class="fw-bold text-truncate text-white small">${escapeHtml(m.itemName)}</div>
                                <div class="small text-muted text-truncate"><i class="fas fa-map-marker-alt me-1"></i>${escapeHtml(m.location)}</div>
                            </div>
                            <span class="badge ${isFound ? 'bg-success' : 'bg-danger'}">${isFound ? 'FOUND' : 'LOST'}</span>
                        </a>
                    `;
                });
                matchesHtml += '</div>';
            } else if (data.isSearch === true) {
                matchesHtml = '<p class="small text-muted mt-1 mb-0"><i class="fas fa-search me-1 text-cyan"></i> No direct database matches found yet.</p>';
            }

            botMsgDiv.innerHTML = `
                <div class="message-content">
                    <p class="mb-1">${formatAiResponse(data.response || 'I analyzed your query and scanned our database.')}</p>
                    ${matchesHtml}
                </div>
            `;

            messagesContainer.appendChild(botMsgDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

            if (data.response) {
                conversationMemory.push({ role: 'assistant', content: data.response });
            }

        } catch (err) {
            console.error('Chat submit error:', err);
            if (loadingDiv.parentNode) messagesContainer.removeChild(loadingDiv);

            const errDiv = document.createElement('div');
            errDiv.className = 'ai-message bot-message';
            errDiv.innerHTML = `<div class="message-content"><p class="mb-0 text-white">Hello! I am your Campus Lost & Found Assistant. How can I help you find or report a lost item on campus today?</p></div>`;
            messagesContainer.appendChild(errDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    });

    function formatAiResponse(str) {
        if (!str) return '';
        let escaped = escapeHtml(str);
        // Format **bold**
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white">$1</strong>');
        // Format *italic*
        escaped = escaped.replace(/\*(.*?)\*/g, '<em>$1</em>');
        // Format linebreaks
        escaped = escaped.replace(/\n/g, '<br>');
        return escaped;
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
});
</script>
