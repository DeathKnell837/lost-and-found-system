<aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
        <a href="/admin/dashboard" class="sidebar-brand d-flex align-items-center gap-2">
            <div class="sidebar-brand-icon d-flex align-items-center justify-content-center rounded-3" style="width: 32px; height: 32px; background: linear-gradient(135deg, rgba(59, 130, 246, 0.25), rgba(6, 182, 212, 0.25)); border: 1px solid rgba(6, 182, 212, 0.4); flex-shrink: 0;">
                <i class="fas fa-shield-alt text-cyan" style="font-size: 0.95rem;"></i>
            </div>
            <div class="d-flex flex-column" style="line-height: 1.15;">
                <span class="fw-bold text-white" style="font-size: 0.85rem; letter-spacing: -0.01em;">Campus L&amp;F</span>
                <span class="text-cyan small fw-semibold" style="font-size: 0.62rem; letter-spacing: 0.05em; text-transform: uppercase;">Admin Portal</span>
            </div>
        </a>
    </div>
    
    <nav class="sidebar-nav">
        <ul class="nav flex-column">
            <li class="nav-section">MAIN MENU</li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>" href="/admin/dashboard">
                    <i class="fas fa-th-large me-2"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'statistics' ? 'active' : '' %>" href="/admin/statistics">
                    <i class="fas fa-chart-bar me-2"></i>
