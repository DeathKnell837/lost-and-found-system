                    <span>All Items</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/items?type=lost&status=approved">
                    <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                    <span>Lost Items</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/items?type=found&status=approved">
                    <i class="fas fa-check-circle text-success me-2"></i>
                    <span>Found Items</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/items?status=claimed">
