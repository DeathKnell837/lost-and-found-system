<aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
        <a href="/admin/dashboard" class="sidebar-brand d-flex align-items-center gap-2">
            <img src="/images/ai-logo.jpg" alt="Logo" class="rounded-circle shadow-sm" style="width: 32px; height: 32px; object-fit: cover; border: 1.5px solid #3b82f6;">
            <span class="fw-bold">Lost & Found Admin</span>
        </a>
    </div>
    
    <nav class="sidebar-nav">
        <ul class="nav flex-column">
            <li class="nav-section">MENU</li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>" href="/admin/dashboard">
                    <i class="fas fa-grid-2 me-2"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'statistics' ? 'active' : '' %>" href="/admin/statistics">
                    <i class="fas fa-chart-line-up me-2"></i>
                    <span>Security & Analytics</span>
                </a>
            </li>
            
            <li class="nav-section">CAMPUS VAULT</li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'pending' ? 'active' : '' %>" href="/admin/items/pending">
                    <i class="fas fa-clock-rotate-left me-2"></i>
                    <span>Pending Review</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'items' ? 'active' : '' %>" href="/admin/items">
                    <i class="fas fa-boxes-stacked me-2"></i>
                    <span>All Belongings</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/items?type=lost&status=approved">
                    <i class="fas fa-circle-exclamation text-danger me-2"></i>
                    <span>Lost Items</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/items?type=found&status=approved">
                    <i class="fas fa-circle-check text-success me-2"></i>
                    <span>Found Items</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/items?status=claimed">
                    <i class="fas fa-handshake-angle text-info me-2"></i>
                    <span>Reunited Items</span>
                </a>
            </li>

            <li class="nav-section">AI INTELLIGENCE</li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'matching' ? 'active' : '' %>" href="/admin/matching">
                    <i class="fas fa-wand-magic-sparkles text-cyan me-2"></i>
                    <span>AI Visual Matching</span>
                </a>
            </li>
            
            <li class="nav-section">REUNIFICATION DESK</li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'claims' ? 'active' : '' %>" href="/admin/claims">
                    <i class="fas fa-id-card-clip me-2"></i>
                    <span>Claim Requests</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/claims?status=pending">
                    <i class="fas fa-hourglass-half text-warning me-2"></i>
                    <span>Pending Verification</span>
                </a>
            </li>
            
            <li class="nav-section">SYSTEM & PREFERENCES</li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'categories' ? 'active' : '' %>" href="/admin/categories">
                    <i class="fas fa-tags me-2"></i>
                    <span>Categories</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'locations' ? 'active' : '' %>" href="/admin/locations">
                    <i class="fas fa-location-dot me-2"></i>
                    <span>Locations</span>
                    <% if (typeof pendingLocationCount !== 'undefined' && pendingLocationCount > 0) { %>
                        <span class="badge bg-warning text-dark ms-auto"><%= pendingLocationCount %></span>
                    <% } %>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'users' ? 'active' : '' %>" href="/admin/users">
                    <i class="fas fa-users-gear me-2"></i>
                    <span>Users & Access</span>
                </a>
            </li>
            
            <li class="nav-section">Quick Links</li>
            
            <li class="nav-item">
                <a class="nav-link" href="/" target="_blank">
                    <i class="fas fa-globe"></i>
                    <span>View Website</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-danger" href="/admin/logout">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Sign Out</span>
                </a>
            </li>
        </ul>
    </nav>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
