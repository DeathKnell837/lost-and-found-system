                </a>
            </li>
            
            <li class="nav-section">ITEM MANAGEMENT</li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'pending' ? 'active' : '' %>" href="/admin/items/pending">
                    <i class="fas fa-clock text-warning me-2"></i>
                    <span>Pending Review</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'items' ? 'active' : '' %>" href="/admin/items">
