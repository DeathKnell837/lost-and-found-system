                    <span>AI Visual Matching</span>
                </a>
            </li>
            
            <li class="nav-section">CLAIM REQUESTS</li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'claims' ? 'active' : '' %>" href="/admin/claims">
                    <i class="fas fa-hand-holding me-2"></i>
                    <span>All Claims</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/admin/claims?status=pending">
                    <i class="fas fa-hourglass-half text-warning me-2"></i>
                    <span>Pending Claims</span>
                </a>
            </li>
            
            <li class="nav-section">SYSTEM CONFIGURATION</li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'categories' ? 'active' : '' %>" href="/admin/categories">
                    <i class="fas fa-tags me-2"></i>
                    <span>Categories</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'locations' ? 'active' : '' %>" href="/admin/locations">
