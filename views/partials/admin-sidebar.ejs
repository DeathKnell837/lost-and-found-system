                    <span>Locations</span>
                    <% if (typeof pendingLocationCount !== 'undefined' && pendingLocationCount > 0) { %>
                        <span class="badge bg-warning text-dark ms-auto"><%= pendingLocationCount %></span>
                    <% } %>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'users' ? 'active' : '' %>" href="/admin/users">
