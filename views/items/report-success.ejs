<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/"><i class="fas fa-home me-1"></i>Home</a></li>
                    <li class="breadcrumb-item"><a href="/items/<%= reportType %>"><%= reportType === 'lost' ? 'Lost Items' : 'Found Items' %></a></li>
                    <li class="breadcrumb-item active" aria-current="page">Report Submitted</li>
                </ol>
            </nav>

            <!-- Success Confirmation Card -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-body p-4 p-md-5 text-center" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(59, 130, 246, 0.05) 100%);">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success text-white mb-3 shadow" style="width: 72px; height: 72px; font-size: 2rem;">
                        <i class="fas fa-check"></i>
                    </div>
                    <h3 class="fw-bold mb-2">Report Submitted Successfully</h3>
                    <p class="text-muted mx-auto mb-3" style="max-width: 540px;">
                        Your <%= reportType === 'lost' ? 'lost item report' : 'found item turnover' %> for 
                        <strong class="text-dark"><%= item.itemName %></strong> has been recorded into the campus database.
                    </p>

                    <div class="d-inline-flex flex-wrap align-items-center justify-content-center gap-2 p-2 px-3 rounded-pill border bg-white shadow-xs">
                        <span class="badge bg-primary px-2 py-1">
                            <i class="fas fa-hashtag me-1"></i>Ref: <%= item._id.toString().slice(-6).toUpperCase() %>
                        </span>
                        <span class="text-muted small">
                            <i class="fas fa-calendar-alt me-1"></i><%= new Date(item.dateReported).toLocaleDateString() %>
                        </span>
                        <span class="badge bg-warning text-dark px-2 py-1">
                            <i class="fas fa-shield-alt me-1"></i>Pending Security Review
                        </span>
                    </div>
                </div>
            </div>

            <!-- Instant AI Correlated Matches -->
            <% if (matches && matches.length > 0) { %>
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4 border-start border-4 border-info">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="fas fa-magic text-info"></i>
                                Instant AI Match Correlation
                            </h5>
                            <small class="text-muted">We identified <%= matches.length %> item(s) already logged in campus records that match your report</small>
                        </div>
                        <span class="badge bg-info bg-opacity-10 text-primary border border-info border-opacity-25 px-2 py-1">
                            <i class="fas fa-microchip me-1"></i>Gemini Visual Engine
                        </span>
                    </div>
                    <div class="card-body p-3 p-md-4">
                        <div class="row g-3">
                            <% matches.forEach(function(m) { %>
                                <div class="col-12 col-md-6">
                                    <div class="card h-100 border rounded-3 p-3 shadow-xs hover-elevate transition-all" style="background: var(--card-bg, #ffffff);">
                                        <div class="d-flex align-items-start gap-3">
                                            <% if (m.item.imagePath) { %>
                                                <img src="<%= m.item.imagePath %>" class="rounded-3 border object-fit-cover flex-shrink-0" style="width: 72px; height: 72px;" alt="<%= m.item.itemName %>">
                                            <% } else { %>
                                                <div class="rounded-3 border d-flex align-items-center justify-content-center flex-shrink-0 bg-light" style="width: 72px; height: 72px; font-size: 1.5rem; color: #64748b;">
                                                    <i class="fas <%= (m.item.category && m.item.category.icon) ? m.item.category.icon : 'fa-box' %>"></i>
                                                </div>
                                            <% } %>

                                            <div class="flex-grow-1 min-w-0">
                                                <div class="d-flex justify-content-between align-items-start gap-1 mb-1">
                                                    <h6 class="fw-bold text-truncate mb-0" style="font-size: 0.95rem;">
                                                        <%= m.item.itemName %>
                                                    </h6>
                                                    <span class="badge <%= m.score >= 70 ? 'bg-success' : 'bg-primary' %> text-white flex-shrink-0" style="font-size: 0.72rem;">
                                                        <%= m.score %>% MATCH
                                                    </span>
                                                </div>

                                                <div class="text-muted small mb-2" style="font-size: 0.76rem; line-height: 1.4;">
                                                    <div><i class="fas fa-map-marker-alt text-danger me-1"></i><%= m.item.location || 'Campus' %></div>
                                                    <div><i class="fas fa-tags text-primary me-1"></i><%= m.item.category ? m.item.category.name : 'Belonging' %></div>
                                                </div>

                                                <a href="/items/<%= m.item._id %>" class="btn btn-sm btn-outline-primary w-100 py-1" style="font-size: 0.78rem;">
                                                    <i class="fas fa-eye me-1"></i> Inspect &amp; Verify Item
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Campus Custody & Retrieval Guide -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="fas fa-building-shield text-primary"></i>
                        Notre Dame of Midsayap College - Custody Office Info
                    </h6>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border h-100">
                                <div class="fw-semibold text-dark small mb-1">
                                    <i class="fas fa-map-marker-alt text-danger me-1"></i> Office Location
                                </div>
                                <div class="text-muted small">
                                    Main Administration Building, Ground Floor<br>
                                    Campus Security &amp; Property Custodian Desk
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border h-100">
                                <div class="fw-semibold text-dark small mb-1">
                                    <i class="fas fa-clock text-info me-1"></i> Operating Hours &amp; Hotline
                                </div>
                                <div class="text-muted small">
                                    Monday &ndash; Friday: 8:00 AM &ndash; 6:00 PM<br>
                                    Contact Desk: <strong>0956-932-7442</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="/items/<%= reportType %>" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                    <i class="fas fa-arrow-left me-1"></i> Browse <%= reportType === 'lost' ? 'Lost' : 'Found' %> Catalog
                </a>
                <a href="/" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
                    <i class="fas fa-home me-1"></i> Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>
