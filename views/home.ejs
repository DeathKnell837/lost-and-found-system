{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Campus Lost & Found Management System",
  "url": "https://lost-and-found-system-7ro8.onrender.com",
  "description": "Campus Lost & Found Management System - Report and find lost items on campus. Simple, fast, and effective.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://lost-and-found-system-7ro8.onrender.com/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

