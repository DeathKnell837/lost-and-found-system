<!-- JSON-LD Structured Data for SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Campus Lost & Found Management System",
  "url": "https://lost-and-found-system-7ro8.onrender.com",
  "description": "Campus Lost & Found Management System - Report and find lost items on campus. Simple, fast, and effective.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://lost-and-found-system-7ro8.onrender.com/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-6 reveal-up" data-delay="0">
                <h1 class="display-4 fw-bold mb-4">Lost Something? Found Something?</h1>
                <p class="lead mb-4">
                    Our campus lost and found system helps you report lost items or
                    help reunite found items with their owners. Simple, fast, and effective.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/report/lost" class="btn btn-danger btn-lg">
                        <i class="fas fa-exclamation-triangle me-2"></i> Report Lost Item
                    </a>
                    <a href="/report/found" class="btn btn-success btn-lg">
                        <i class="fas fa-hand-holding-heart me-2"></i> Report Found Item
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center mt-5 mt-lg-0 reveal-up" data-delay="150">
                <div class="hero-illustration">
                    <div class="radar-sweep-ring"></div>
                    <div class="radar-pulse-ring"></div>
                    <i class="fas fa-search-location"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4 reveal-up" data-delay="0">
                <div class="stat-card text-center p-4 rounded">
                    <div class="stat-icon text-danger mb-3">
                        <i class="fas fa-exclamation-circle fa-3x"></i>
                    </div>
                    <h2 class="stat-number" data-target="<%= stats.totalLost %>">
                        0
                    </h2>
                    <p class="stat-label text-muted mb-0">Lost Items Reported</p>
                </div>
            </div>
            <div class="col-md-4 reveal-up" data-delay="80">
                <div class="stat-card text-center p-4 rounded">
                    <div class="stat-icon text-success mb-3">
                        <i class="fas fa-check-circle fa-3x"></i>
                    </div>
                    <h2 class="stat-number" data-target="<%= stats.totalFound %>">
                        0
                    </h2>
                    <p class="stat-label text-muted mb-0">Found Items Reported</p>
                </div>
            </div>
            <div class="col-md-4 reveal-up" data-delay="160">
                <div class="stat-card text-center p-4 rounded">
                    <div class="stat-icon text-warning mb-3">
                        <i class="fas fa-handshake fa-3x"></i>
                    </div>
                    <h2 class="stat-number" data-target="<%= stats.totalClaimed %>">
                        0
                    </h2>
                    <p class="stat-label text-muted mb-0">Items Successfully Claimed</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Search Section -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 reveal-up" data-delay="100">
                <div class="search-box p-4 rounded">
                    <h4 class="text-center mb-2">
                        <i class="fas fa-search me-2 text-warning"></i> Search for Items
                    </h4>
                    <div class="copper-divider mx-auto mb-4"></div>
                    <form action="/search" method="GET">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-lg" name="q"
                                    placeholder="Search by item name, description, or location...">
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary btn-lg w-100">
                                    <i class="fas fa-search me-2"></i> Search
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Recent Lost Items -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-2 reveal-up">
            <div>
                <h3 class="section-title mb-1">
                    <i class="fas fa-exclamation-circle text-danger me-2"></i> Recent Lost Items
                </h3>
                <div class="copper-divider mb-0"></div>
            </div>
            <a href="/items/lost" class="btn btn-outline-danger">
                View All <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <% if (recentLost.length> 0) { %>
            <div class="row g-4 mt-1">
                <% recentLost.forEach(function(item, index) { %>
                    <div class="col-md-6 col-lg-4 reveal-up" data-delay="<%= index * 80 %>">
                        <%- include('partials/item-card', { item: item }) %>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <div class="text-center py-5 reveal-up">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <p class="text-muted">No lost items reported yet.</p>
                </div>
                <% } %>
    </div>
</section>

<!-- Recent Found Items -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-2 reveal-up">
            <div>
                <h3 class="section-title mb-1">
                    <i class="fas fa-check-circle text-success me-2"></i> Recent Found Items
                </h3>
                <div class="copper-divider mb-0"></div>
            </div>
            <a href="/items/found" class="btn btn-outline-success">
                View All <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <% if (recentFound.length> 0) { %>
            <div class="row g-4 mt-1">
                <% recentFound.forEach(function(item, index) { %>
                    <div class="col-md-6 col-lg-4 reveal-up" data-delay="<%= index * 80 %>">
                        <%- include('partials/item-card', { item: item }) %>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <div class="text-center py-5 reveal-up">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <p class="text-muted">No found items reported yet.</p>
                </div>
                <% } %>
    </div>
</section>

<!-- How It Works -->
<section class="py-5 bg-primary text-white">
    <div class="container">
        <div class="text-center mb-5 reveal-up">
            <h3 class="mb-1">How It Works</h3>
            <div class="copper-divider mx-auto"></div>
        </div>
        <div class="row g-4">
            <div class="col-md-4 reveal-up" data-delay="0">
                <div class="text-center card p-4 h-100">
                    <div class="step-number mb-3 text-warning fw-bold fs-3">1</div>
                    <h5>Report</h5>
                    <p class="mb-0 text-muted">Submit a detailed report of your lost or found item with photos and description.</p>
                </div>
            </div>
            <div class="col-md-4 reveal-up" data-delay="80">
                <div class="text-center card p-4 h-100">
                    <div class="step-number mb-3 text-warning fw-bold fs-3">2</div>
                    <h5>Review</h5>
                    <p class="mb-0 text-muted">Our admin team reviews and approves your report for public listing.</p>
                </div>
            </div>
            <div class="col-md-4 reveal-up" data-delay="160">
                <div class="text-center card p-4 h-100">
                    <div class="step-number mb-3 text-warning fw-bold fs-3">3</div>
                    <h5>Connect</h5>
                    <p class="mb-0 text-muted">Get connected with the finder/owner and claim your item.</p>
                </div>
            </div>
        </div>
    </div>
</section>