<!-- Hero Section -->
<section class="hero-section py-5">
    <div class="container">
        <div class="row align-items-center min-vh-50 py-3">
            <div class="col-lg-6 reveal-up" data-delay="0">
                <div class="portal-badge-pill mb-3">
                    <i class="fas fa-shield-alt text-cyan me-2"></i> Campus AI Reunification Portal
                    <span class="badge bg-success ms-2 rounded-pill px-2 py-1 style-dot-pulse"><i class="fas fa-circle style-dot me-1"></i> Online</span>
                </div>
                <h1 class="hero-title display-4 fw-bold mb-4">
                    Lost Something? <span class="text-gradient-cyan">Found Something?</span>
                </h1>
                <p class="lead mb-4 text-light-gray">
                    Our campus lost and found platform uses Gemini AI visual recognition to automatically match lost belongings with found items. Fast, secure, and built for student reunification.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="/report/lost" class="btn btn-danger btn-lg shadow-danger-glow">
                        <i class="fas fa-exclamation-triangle me-2"></i> Report Lost Item
                    </a>
                    <a href="/report/found" class="btn btn-success btn-lg shadow-success-glow">
                        <i class="fas fa-hand-holding-heart me-2"></i> Report Found Item
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center mt-5 mt-lg-0 reveal-up" data-delay="150">
                <div class="hero-illustration">
                    <div class="radar-sweep-ring"></div>
                    <div class="radar-pulse-ring"></div>
                    <i class="fas fa-search-location"></i>
                </div>
                <div class="mt-3">
                    <span class="badge bg-dark border border-cyan text-cyan px-3 py-2 rounded-pill">
                        <i class="fas fa-sparkles me-1"></i> 98%+ AI Visual Match Accuracy
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics Section -->
<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4 reveal-up" data-delay="0">
                <div class="stat-card text-center p-4 rounded border-danger-glow">
                    <div class="stat-icon text-danger mb-3">
                        <i class="fas fa-exclamation-circle fa-3x"></i>
                    </div>
                    <h2 class="stat-number text-white fw-bold display-5 mb-1" data-target="<%= stats ? stats.totalLost : 0 %>">
                        <%= stats ? stats.totalLost : 0 %>
                    </h2>
                    <p class="stat-label text-muted mb-0 fw-semibold">Lost Items Reported</p>
                    <small class="text-secondary">Logged by Students & Staff</small>
                </div>
            </div>
            <div class="col-md-4 reveal-up" data-delay="80">
                <div class="stat-card text-center p-4 rounded border-success-glow">
                    <div class="stat-icon text-success mb-3">
                        <i class="fas fa-check-circle fa-3x"></i>
                    </div>
                    <h2 class="stat-number text-white fw-bold display-5 mb-1" data-target="<%= stats ? stats.totalFound : 0 %>">
                        <%= stats ? stats.totalFound : 0 %>
                    </h2>
                    <p class="stat-label text-muted mb-0 fw-semibold">Found Items Reported</p>
                    <small class="text-secondary">Secured by Campus Security</small>
                </div>
            </div>
            <div class="col-md-4 reveal-up" data-delay="160">
                <div class="stat-card text-center p-4 rounded border-cyan-glow">
                    <div class="stat-icon text-cyan mb-3">
                        <i class="fas fa-handshake fa-3x"></i>
                    </div>
                    <h2 class="stat-number text-white fw-bold display-5 mb-1" data-target="<%= stats ? stats.totalClaimed : 0 %>">
                        <%= stats ? stats.totalClaimed : 0 %>
                    </h2>
                    <p class="stat-label text-muted mb-0 fw-semibold">Items Successfully Claimed</p>
                    <small class="text-secondary">Reunited via Gemini AI</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Search Section -->
<section class="py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 reveal-up" data-delay="100">
                <div class="search-box p-4 rounded border-cyan-glow">
                    <h4 class="text-center mb-2 text-white fw-bold">
                        <i class="fas fa-search me-2 text-cyan"></i> Search Campus Database
                    </h4>
                    <p class="text-center text-muted small mb-3">Type any keyword, item name, color, brand, or campus location</p>
                    <div class="copper-divider mx-auto mb-4"></div>
                    <form action="/search" method="GET">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <input type="text" class="form-control form-control-lg bg-dark text-white border-secondary" name="q"
                                    placeholder="e.g. Black leather wallet near library, AirPods case, keys...">
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                                    <i class="fas fa-search me-2"></i> Search Items
                                </button>
                            </div>
                        </div>
                    </form>
                    <!-- Quick Tag Pills -->
                    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3 pt-2">
                        <span class="small text-muted align-self-center me-1">Popular searches:</span>
                        <a href="/search?q=wallet" class="tag-pill"><i class="fas fa-wallet me-1 text-cyan"></i> Wallets</a>
                        <a href="/search?q=keys" class="tag-pill"><i class="fas fa-key me-1 text-cyan"></i> Keys</a>
                        <a href="/search?q=phone" class="tag-pill"><i class="fas fa-mobile-alt me-1 text-cyan"></i> Phones</a>
                        <a href="/search?q=airpods" class="tag-pill"><i class="fas fa-headphones me-1 text-cyan"></i> AirPods</a>
                        <a href="/search?q=backpack" class="tag-pill"><i class="fas fa-shopping-bag me-1 text-cyan"></i> Bags</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Recent Lost Items -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 reveal-up">
            <div>
                <h3 class="section-title mb-1 text-white fw-bold">
                    <i class="fas fa-exclamation-circle text-danger me-2"></i> Recent Lost Items
                </h3>
                <div class="copper-divider mb-0"></div>
            </div>
            <a href="/items/lost" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                View All <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <% if (recentLost && recentLost.length > 0) { %>
            <div class="row g-4 mt-1">
                <% recentLost.forEach(function(item, index) { %>
                    <div class="col-md-6 col-lg-4 reveal-up" data-delay="<%= index * 80 %>">
                        <%- include('partials/item-card', { item: item }) %>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <div class="stat-card text-center py-5 px-4 reveal-up rounded">
                    <div class="ai-avatar-badge mx-auto mb-3" style="width:54px; height:54px; font-size:1.5rem;">
                        <i class="fas fa-box-open text-cyan"></i>
                    </div>
                    <h5 class="text-white fw-bold mb-1">No Lost Items Reported</h5>
                    <p class="text-muted small mb-3">All reported lost belongings on campus have been accounted for or reunited!</p>
                    <a href="/report/lost" class="btn btn-outline-danger btn-sm rounded-pill px-4">
                        <i class="fas fa-plus me-1"></i> Report a Misplaced Item
                    </a>
                </div>
                <% } %>
    </div>
</section>

<!-- Recent Found Items -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 reveal-up">
            <div>
                <h3 class="section-title mb-1 text-white fw-bold">
                    <i class="fas fa-check-circle text-success me-2"></i> Recent Found Items
                </h3>
                <div class="copper-divider mb-0"></div>
            </div>
            <a href="/items/found" class="btn btn-outline-success btn-sm rounded-pill px-3">
                View All <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>

        <% if (recentFound && recentFound.length > 0) { %>
            <div class="row g-4 mt-1">
                <% recentFound.forEach(function(item, index) { %>
                    <div class="col-md-6 col-lg-4 reveal-up" data-delay="<%= index * 80 %>">
                        <%- include('partials/item-card', { item: item }) %>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <div class="stat-card text-center py-5 px-4 reveal-up rounded">
                    <div class="ai-avatar-badge mx-auto mb-3" style="width:54px; height:54px; font-size:1.5rem;">
                        <i class="fas fa-hands-helping text-success"></i>
                    </div>
                    <h5 class="text-white fw-bold mb-1">No Found Items Pending</h5>
                    <p class="text-muted small mb-3">Found someone's lost belongings on campus? Help them reunite by reporting it below.</p>
                    <a href="/report/found" class="btn btn-outline-success btn-sm rounded-pill px-4">
                        <i class="fas fa-plus me-1"></i> Report a Found Item
                    </a>
                </div>
                <% } %>
    </div>
</section>

<!-- How It Works Section -->
<section class="how-it-works-section py-5">
    <div class="container position-relative">
        <div class="text-center mb-5 reveal-up">
            <h2 class="section-title mb-2 text-white fw-bold">How It Works</h2>
            <p class="text-secondary fs-6 mb-0">Three simple steps to reunite lost belongings with their rightful owners</p>
            <div class="copper-divider mx-auto mt-3"></div>
        </div>
        <div class="row g-4 position-relative">
            <div class="col-md-4 reveal-up" data-delay="0">
                <div class="step-card text-center h-100 p-4">
                    <span class="step-pill">Step 01</span>
                    <div class="step-icon-portal">
                        <i class="fas fa-file-signature"></i>
                    </div>
                    <h3 class="step-title">1. Report</h3>
                    <p class="step-desc">Submit a detailed report of your lost or found item with location, photos, and descriptions.</p>
                </div>
            </div>
            <div class="col-md-4 reveal-up" data-delay="80">
                <div class="step-card text-center h-100 p-4">
                    <span class="step-pill">Step 02</span>
                    <div class="step-icon-portal">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3 class="step-title">2. Review</h3>
                    <p class="step-desc">Our campus security & admin team verifies the details and approves your submission for matching.</p>
                </div>
            </div>
            <div class="col-md-4 reveal-up" data-delay="160">
                <div class="step-card text-center h-100 p-4">
                    <span class="step-pill">Step 03</span>
                    <div class="step-icon-portal">
                        <i class="fas fa-hands-helping"></i>
                    </div>
                    <h3 class="step-title">3. Reunite</h3>
                    <p class="step-desc">Gemini AI matches items automatically, connecting finder and owner safely on campus.</p>
                </div>
            </div>
        </div>
    </div>
</section>