<div class="cyber-dashboard">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-white d-flex align-items-center gap-2" style="letter-spacing: -0.02em;">
                <i class="fas fa-map-marker-alt text-cyan"></i>
                Campus Locations &amp; Zones
            </h4>
            <span class="text-muted small" style="font-size: 0.76rem;">Manage official building zones and review student-suggested locations</span>
        </div>
        <button class="btn btn-sm btn-primary py-1 px-3 d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addLocationModal" style="font-size: 0.76rem;">
            <i class="fas fa-plus"></i> Add New Location
        </button>
    </div>

    <!-- ========== Pending Suggestions Section ========== -->
    <% if (typeof pendingLocations !== 'undefined' && pendingLocations.length > 0) { %>
        <div class="cyber-card p-3 mb-3" style="border: 1px solid rgba(245, 158, 11, 0.3);">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-warning mb-0 fw-bold d-flex align-items-center gap-2" style="font-size: 0.82rem;">
                    <i class="fas fa-lightbulb"></i> User-Suggested Campus Locations
                    <span class="badge bg-warning text-dark" style="font-size: 0.68rem;"><%= pendingLocations.length %> New</span>
                </h6>
                <span class="text-muted small" style="font-size: 0.7rem;">Suggested when students selected "Other"</span>
            </div>
            
            <div class="table-responsive">
                <table class="cyber-table">
                    <thead>
                        <tr>
                            <th>Location Name</th>
                            <th>Suggested By</th>
                            <th>Used In</th>
                            <th>Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pendingLocations.forEach(function(loc) { %>
                            <tr>
                                <td>
                                    <strong class="text-white"><%= loc.name %></strong>
                                </td>
                                <td>
                                    <% if (loc.suggestedBy) { %>
                                        <span class="text-white d-block" style="font-size: 0.76rem;"><%= loc.suggestedBy.username %></span>
                                        <small class="text-muted" style="font-size: 0.68rem;"><%= loc.suggestedBy.email %></small>
                                    <% } else { %>
                                        <small class="text-muted">Guest Student</small>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary text-info" style="font-size: 0.7rem;"><%= loc.itemCount || 0 %> items</span>
                                </td>
                                <td>
                                    <small class="text-muted"><%= new Date(loc.createdAt).toLocaleDateString() %></small>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <button class="btn btn-sm btn-success py-0 px-2" style="font-size: 0.7rem;" data-bs-toggle="modal" data-bs-target="#approveModal<%= loc._id %>">
                                            <i class="fas fa-check me-1"></i> Approve
                                        </button>
                                        <form action="/admin/locations/<%= loc._id %>/reject" method="POST" class="d-inline mb-0"
                                              onsubmit="return confirm('Reject this suggested location?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 0.7rem;">
                                                <i class="fas fa-times me-1"></i> Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            <!-- Approve Modal -->
                            <div class="modal fade" id="approveModal<%= loc._id %>" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content cyber-card">
                                        <form action="/admin/locations/<%= loc._id %>/approve" method="POST">
                                            <div class="modal-header py-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                                <h6 class="modal-title small fw-bold text-success">
                                                    <i class="fas fa-check-circle me-1"></i> Approve Location
                                                </h6>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body py-3">
                                                <div class="mb-2">
                                                    <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Location Name <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control cyber-select py-1 px-2" name="name" 
                                                           value="<%= loc.name %>" required maxlength="100" style="font-size: 0.76rem;">
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Description (Optional)</label>
                                                    <textarea class="form-control cyber-select py-1 px-2" name="description" rows="2" 
                                                              maxlength="200" placeholder="e.g., Near the main entrance" style="font-size: 0.76rem;"><%= loc.description || '' %></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer py-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
                                                <button type="button" class="btn btn-sm btn-outline-light border-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="fas fa-check me-1"></i> Approve &amp; Add
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

    <!-- ========== Approved Locations Grid ========== -->
    <% if (locations.length === 0) { %>
        <div class="cyber-card p-5 text-center">
            <div class="cyber-thumb-placeholder mx-auto mb-3" style="width: 50px; height: 50px; font-size: 1.3rem;">
                <i class="fas fa-map-marker-alt text-muted"></i>
            </div>
            <p class="text-muted small mb-0">No campus locations configured yet. Click "Add New Location" above.</p>
        </div>
    <% } else { %>
        <div class="row g-2">
            <% locations.forEach(function(loc) { %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="cyber-card p-3 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-2">
                                <div class="cyber-thumb-placeholder me-2" style="width: 44px; height: 44px; font-size: 1.2rem; background: rgba(239, 68, 68, 0.08); border-color: rgba(239, 68, 68, 0.2);">
                                    <i class="fas fa-map-marker-alt text-danger"></i>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <h6 class="text-white mb-0 text-truncate fw-bold" style="font-size: 0.85rem;"><%= loc.name %></h6>
                                    <span class="text-muted small" style="font-size: 0.7rem;">Official Campus Area</span>
                                </div>
                                <span class="cyber-badge <%= loc.isActive ? 'cyber-badge-found' : 'cyber-badge-lost' %>" style="font-size: 0.65rem;">
                                    <%= loc.isActive ? 'ACTIVE' : 'INACTIVE' %>
                                </span>
                            </div>
                            <% if (loc.description) { %>
                                <p class="text-muted small mb-3 p-2 rounded-2" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); font-size: 0.72rem; line-height: 1.4;">
                                    <%= loc.description %>
                                </p>
                            <% } %>
                        </div>
                        <div class="d-flex gap-2 pt-2" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <button class="btn btn-sm btn-outline-light border-secondary flex-grow-1 py-1" style="font-size: 0.72rem;"
                                    data-bs-toggle="modal" data-bs-target="#editModal<%= loc._id %>">
                                <i class="fas fa-edit me-1"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.72rem;"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal<%= loc._id %>" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Edit Modal -->
                    <div class="modal fade" id="editModal<%= loc._id %>" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content cyber-card">
                                <form action="/admin/locations/<%= loc._id %>" method="POST">
                                    <div class="modal-header py-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                        <h6 class="modal-title small fw-bold">Edit Location</h6>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body py-3">
                                        <div class="mb-2">
                                            <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Name <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control cyber-select py-1 px-2" name="name" 
                                                   value="<%= loc.name %>" required maxlength="100" style="font-size: 0.76rem;">
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Description (Optional)</label>
                                            <textarea class="form-control cyber-select py-1 px-2" name="description" rows="2" 
                                                      maxlength="200" style="font-size: 0.76rem;"><%= loc.description || '' %></textarea>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Status</label>
                                            <select class="form-select cyber-select py-1 px-2" name="isActive" style="font-size: 0.76rem;">
                                                <option value="true" <%= loc.isActive ? 'selected' : '' %>>Active</option>
                                                <option value="false" <%= !loc.isActive ? 'selected' : '' %>>Inactive</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="modal-footer py-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
                                        <button type="button" class="btn btn-sm btn-outline-light border-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Delete Modal -->
                    <div class="modal fade" id="deleteModal<%= loc._id %>" tabindex="-1">
                        <div class="modal-dialog modal-sm modal-dialog-centered">
                            <div class="modal-content cyber-card">
                                <div class="modal-header py-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                    <h6 class="modal-title small fw-bold">Delete Location</h6>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body py-2">
                                    <p class="small mb-1">Delete location <strong class="text-white"><%= loc.name %></strong>?</p>
                                    <p class="text-muted small mb-0" style="font-size: 0.7rem;">Existing item records will preserve their text.</p>
                                </div>
                                <div class="modal-footer py-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
                                    <button type="button" class="btn btn-sm btn-outline-light border-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <form action="/admin/locations/<%= loc._id %>/delete" method="POST" class="d-inline mb-0">
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<!-- Add Location Modal -->
<div class="modal fade" id="addLocationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cyber-card">
            <form action="/admin/locations" method="POST">
                <div class="modal-header py-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                    <h6 class="modal-title small fw-bold">Add New Location</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-2">
                        <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Location Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control cyber-select py-1 px-2" name="name" required 
                               placeholder="e.g., University Library 2nd Floor" maxlength="100" style="font-size: 0.76rem;">
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Description (Optional)</label>
                        <textarea class="form-control cyber-select py-1 px-2" name="description" rows="2" 
                                  placeholder="Additional details about this campus zone..." maxlength="200" style="font-size: 0.76rem;"></textarea>
                    </div>
                </div>
                <div class="modal-footer py-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
                    <button type="button" class="btn btn-sm btn-outline-light border-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Add Location</button>
                </div>
            </form>
        </div>
    </div>
</div>
