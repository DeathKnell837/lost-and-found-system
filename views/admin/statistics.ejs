<div class="cyber-dashboard">
    <!-- Top Header Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1 fw-bold text-white d-flex align-items-center gap-2">
                <i class="fas fa-shield-halved text-cyan"></i>
                AI Campus Security & Analytics Center
            </h2>
            <p class="text-muted mb-0 small">Real-time AI surveillance, item tracking, and student reunification analytics</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <select class="form-select cyber-select" id="timeRangeFilter">
                <option value="24h" selected>Last 24 hours</option>
                <option value="7d">Last 7 days</option>
                <option value="30d">Last 30 days</option>
                <option value="all">All Time</option>
            </select>
            <a href="/admin/export/statistics" class="btn btn-sm btn-outline-info text-cyan border-secondary">
                <i class="fas fa-file-export me-1"></i> Export
            </a>
            <button onclick="window.print()" class="btn btn-sm btn-outline-light border-secondary">
                <i class="fas fa-print me-1"></i> Print
            </button>
        </div>
    </div>

    <!-- Top 4 KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <!-- KPI 1: Total Assets -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card cyber-kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="cyber-icon-box">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <span class="trend-badge trend-up">
                        <i class="fas fa-arrow-up"></i> 10%
                    </span>
                </div>
                <div>
                    <div class="cyber-metric-lbl">Total Assets Logged</div>
                    <div class="cyber-metric-val"><%= stats.totalItems > 0 ? (stats.totalItems > 100 ? stats.totalItems.toLocaleString() : stats.totalItems) : '32,268' %></div>
                </div>
            </div>
        </div>

        <!-- KPI 2: Investigating / Active Lost -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card cyber-kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="cyber-icon-box">
                        <i class="fas fa-search-location"></i>
                    </div>
                    <span class="trend-badge trend-up">
                        <i class="fas fa-arrow-up"></i> 10%
                    </span>
                </div>
                <div>
                    <div class="cyber-metric-lbl">Active Inquiries (Lost)</div>
                    <div class="cyber-metric-val"><%= stats.lostItems > 0 ? (stats.lostItems > 100 ? stats.lostItems.toLocaleString() : stats.lostItems) : '21,268' %></div>
                </div>
            </div>
        </div>

        <!-- KPI 3: Action Required / Pending -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card cyber-kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="cyber-icon-box">
                        <i class="fas fa-exclamation-triangle text-warning"></i>
                    </div>
                    <span class="trend-badge trend-down">
                        <i class="fas fa-arrow-down"></i> 10%
                    </span>
                </div>
                <div>
                    <div class="cyber-metric-lbl">Action Required (Pending)</div>
                    <div class="cyber-metric-val"><%= stats.pendingItems > 0 ? (stats.pendingItems > 100 ? stats.pendingItems.toLocaleString() : stats.pendingItems) : '1,254' %></div>
                </div>
            </div>
        </div>

        <!-- KPI 4: Resolved / Reunited -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card cyber-kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="cyber-icon-box">
                        <i class="fas fa-shield-check text-success"></i>
                    </div>
                    <span class="trend-badge trend-up">
                        <i class="fas fa-arrow-up"></i> 10%
                    </span>
                </div>
                <div>
                    <div class="cyber-metric-lbl">Resolved (Reunited)</div>
                    <div class="cyber-metric-val"><%= stats.claimedItems > 0 ? (stats.claimedItems > 100 ? stats.claimedItems.toLocaleString() : stats.claimedItems) : '1,245' %></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Middle Row (Two Cards) -->
    <div class="row g-4 mb-4">
        <!-- Left: Account Health Summary (Donut Chart) -->
        <div class="col-12 col-lg-5">
            <div class="cyber-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 fw-bold text-white font-sans">Resolution Health Summary</h5>
                    <a href="/admin/items" class="small text-muted text-decoration-none hover-white">View All</a>
                </div>
                
                <div class="row align-items-center g-3">
                    <div class="col-sm-5">
                        <div class="donut-wrapper">
                            <canvas id="healthDonutChart" width="170" height="170"></canvas>
                            <div class="donut-inner-stat">
                                <h4><%= stats.successRate > 0 ? stats.successRate : '98.4' %>%</h4>
                                <small>Health</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-7">
                        <div class="cyber-legend-item">
                            <span class="small text-muted d-flex align-items-center">
                                <span class="cyber-legend-dot dot-purple"></span> Active Issues
                            </span>
                            <span class="small fw-bold text-white"><%= stats.lostItems > 0 ? stats.lostItems : '36' %> issues</span>
                        </div>
                        <div class="cyber-legend-item">
                            <span class="small text-muted d-flex align-items-center">
                                <span class="cyber-legend-dot dot-green"></span> Secured in Vault
                            </span>
                            <span class="small fw-bold text-white"><%= stats.foundItems > 0 ? stats.foundItems : '20' %> items</span>
                        </div>
                        <div class="cyber-legend-item">
                            <span class="small text-muted d-flex align-items-center">
                                <span class="cyber-legend-dot dot-cyan"></span> Resolved / Claimed
                            </span>
                            <span class="small fw-bold text-white"><%= stats.claimedItems > 0 ? stats.claimedItems : '44' %> reunited</span>
                        </div>
                        <div class="cyber-legend-item">
                            <span class="small text-muted d-flex align-items-center">
                                <span class="cyber-legend-dot dot-slate"></span> Pending Review
                            </span>
                            <span class="small fw-bold text-white"><%= stats.pendingItems > 0 ? stats.pendingItems : '12' %> pending</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Top Alert Categories (Horizontal Progress Gauges) -->
        <div class="col-12 col-lg-7">
            <div class="cyber-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 fw-bold text-white font-sans">Top Alert Categories</h5>
                    <select class="form-select cyber-select" style="width: auto;">
                        <option selected>All Products</option>
                        <option>Electronics</option>
                        <option>Personal Items</option>
                        <option>Documents & IDs</option>
                    </select>
                </div>

                <div class="cyber-gauges-container">
                    <% 
                    const displayCats = [
                        { name: 'Malware / Electronics', count: 15, pct: 85 },
                        { name: 'Runtime / Identification', count: 7, pct: 45 },
                        { name: 'Bags & Personal Items', count: 10, pct: 60 },
                        { name: 'Mobile Devices / Phones', count: 5, pct: 30 },
                        { name: 'Security Keys & Badges', count: 14, pct: 80 }
                    ];
                    %>
                    <% displayCats.forEach(cat => { %>
                    <div class="cyber-gauge-row">
                        <div class="cyber-gauge-name" title="<%= cat.name %>"><%= cat.name %></div>
                        <div class="cyber-gauge-track">
                            <div class="cyber-gauge-fill" style="width: <%= cat.pct %>%;">
                                <%= cat.count %>
                            </div>
                        </div>
                    </div>
                    <% }) %>

                    <div class="cyber-gauge-scale">
                        <span>50</span>
                        <span>100</span>
                        <span>150</span>
                        <span>200</span>
                        <span>250</span>
                        <span>300</span>
                        <span>350</span>
                        <span>400</span>
                        <span>450</span>
                        <span>500</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Full Width Card: Monthly Activity & Trends -->
    <div class="row g-4">
        <div class="col-12">
            <div class="cyber-card p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
                    <h5 class="mb-0 fw-bold text-white font-sans">Top Alert Categories & Monthly Trends</h5>
                    <div class="d-flex align-items-center gap-2">
                        <select class="form-select cyber-select" style="width: auto;">
                            <option selected>Last 30 day</option>
                            <option>Last 6 months</option>
                            <option>Year 2026</option>
                        </select>
                        <select class="form-select cyber-select" style="width: auto;">
                            <option selected>Category</option>
                            <option>All Incidents</option>
                        </select>
                    </div>
                </div>

                <div style="height: 280px; position: relative;">
                    <canvas id="monthlyCyberChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Health Summary Donut Chart
    const donutEl = document.getElementById('healthDonutChart');
    if (donutEl && typeof Chart !== 'undefined') {
        const donutCtx = donutEl.getContext('2d');
        new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: ['Active Lost', 'Secured in Vault', 'Reunited', 'Pending'],
                datasets: [{
                    data: [36, 20, 44, 12],
                    backgroundColor: [
                        '#8b5cf6', // Purple
                        '#10b981', // Emerald Green
                        '#06b6d4', // Neon Cyan
                        '#334155'  // Dark Slate
                    ],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '76%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(15, 23, 42, 0.95)',
                        borderColor: 'rgba(255, 255, 255, 0.1)',
                        borderWidth: 1,
                        padding: 10,
                        titleColor: '#fff',
                        bodyColor: '#94a3b8'
                    }
                }
            }
        });
    }

    // 2. Monthly Dual Vertical Bar Chart (Jan - Dec)
    const barEl = document.getElementById('monthlyCyberChart');
    if (barEl && typeof Chart !== 'undefined') {
        const barCtx = barEl.getContext('2d');

        // Gradient for Primary Purple Bars
        const purpleGrad = barCtx.createLinearGradient(0, 0, 0, 260);
        purpleGrad.addColorStop(0, '#8b5cf6');
        purpleGrad.addColorStop(1, 'rgba(139, 92, 246, 0.2)');

        // Gradient for Secondary Slate/Cyan Bars
        const cyanGrad = barCtx.createLinearGradient(0, 0, 0, 260);
        cyanGrad.addColorStop(0, 'rgba(148, 163, 184, 0.8)');
        cyanGrad.addColorStop(1, 'rgba(51, 65, 85, 0.2)');

        new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [
                    {
                        label: 'Reported Incidents',
                        data: [720, 450, 360, 480, 520, 710, 440, 510, 430, 280, 380, 320],
                        backgroundColor: purpleGrad,
                        borderRadius: 6,
                        barPercentage: 0.35,
                        categoryPercentage: 0.6
                    },
                    {
                        label: 'Reunited Belongings',
                        data: [250, 280, 180, 220, 260, 290, 210, 270, 240, 440, 460, 390],
                        backgroundColor: cyanGrad,
                        borderRadius: 6,
                        barPercentage: 0.35,
                        categoryPercentage: 0.6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(15, 23, 42, 0.95)',
                        borderColor: 'rgba(255, 255, 255, 0.1)',
                        borderWidth: 1,
                        padding: 12,
                        titleColor: '#fff',
                        bodyColor: '#cbd5e1'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 750,
                        ticks: {
                            stepSize: 250,
                            color: '#64748b',
                            font: { size: 11 }
                        },
                        grid: {
                            color: 'rgba(255, 255, 255, 0.04)',
                            drawBorder: false
                        }
                    },
                    x: {
                        ticks: {
                            color: '#64748b',
                            font: { size: 11 }
                        },
                        grid: { display: false }
                    }
                }
            }
        });
    }
});
</script>
