<div class="cyber-dashboard">
    <!-- Top Header Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-white d-flex align-items-center gap-2" style="letter-spacing: -0.02em;">
                <i class="fas fa-chart-bar text-cyan"></i>
                Campus Lost &amp; Found Analytics
            </h4>
            <span class="text-muted small" style="font-size: 0.76rem;">Real-time insights on reported items, category distributions &amp; claim recovery rates</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/admin/export/statistics" class="btn btn-sm btn-outline-info text-cyan border-secondary py-1 px-3" style="font-size: 0.76rem;">
                <i class="fas fa-file-export me-1"></i> Export Data
            </a>
            <button onclick="window.print()" class="btn btn-sm btn-outline-light border-secondary py-1 px-3" style="font-size: 0.76rem;">
                <i class="fas fa-print me-1"></i> Print Report
            </button>
        </div>
    </div>

    <!-- Top 4 KPI Metric Cards -->
    <div class="cyber-kpi-grid">
        <!-- KPI 1: Total Items Logged -->
        <div class="cyber-card cyber-kpi-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="cyber-icon-box">
                    <i class="fas fa-boxes text-info"></i>
                </div>
                <span class="trend-badge trend-up">
                    <i class="fas fa-database"></i> Total
                </span>
            </div>
            <div>
                <div class="cyber-metric-lbl">Total Items Reported</div>
                <div class="cyber-metric-val"><%= stats.totalItems || 0 %></div>
            </div>
        </div>

        <!-- KPI 2: Active Lost Items -->
        <div class="cyber-card cyber-kpi-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="cyber-icon-box">
                    <i class="fas fa-search text-danger"></i>
                </div>
                <span class="trend-badge trend-down">
                    <i class="fas fa-search"></i> Lost
                </span>
            </div>
            <div>
                <div class="cyber-metric-lbl">Active Lost Items</div>
                <div class="cyber-metric-val"><%= stats.lostItems || 0 %></div>
            </div>
        </div>

        <!-- KPI 3: Pending Approval -->
        <div class="cyber-card cyber-kpi-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="cyber-icon-box">
                    <i class="fas fa-clock text-warning"></i>
                </div>
                <span class="trend-badge <%= (stats.pendingItems > 0) ? 'trend-down' : 'trend-up' %>">
                    <i class="fas <%= (stats.pendingItems > 0) ? 'fa-hourglass-half' : 'fa-check' %>"></i> <%= (stats.pendingItems > 0) ? 'Needs Action' : 'All Clear' %>
                </span>
            </div>
            <div>
                <div class="cyber-metric-lbl">Pending Approval</div>
                <div class="cyber-metric-val"><%= stats.pendingItems || 0 %></div>
            </div>
        </div>

        <!-- KPI 4: Claimed & Reunited -->
        <div class="cyber-card cyber-kpi-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="cyber-icon-box">
                    <i class="fas fa-handshake text-success"></i>
                </div>
                <span class="trend-badge trend-up">
                    <i class="fas fa-check"></i> <%= stats.successRate || 0 %>% Rate
                </span>
            </div>
            <div>
                <div class="cyber-metric-lbl">Claimed &amp; Reunited</div>
                <div class="cyber-metric-val"><%= stats.claimedItems || 0 %></div>
            </div>
        </div>
    </div>

    <!-- Middle Row (Two Cards Side-by-Side) -->
    <div class="cyber-stats-grid">
        <!-- Left: Item Status & Recovery Breakdown (Donut Chart) -->
        <div class="cyber-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 fw-bold text-white font-sans" style="font-size: 0.85rem;">Item Status &amp; Recovery Breakdown</h6>
                <a href="/admin/items" class="text-muted text-decoration-none hover-white" style="font-size: 0.72rem;">View All <i class="fas fa-chevron-right ms-1"></i></a>
            </div>
            
            <div class="row align-items-center g-2 mt-1">
                <div class="col-5 text-center">
                    <div class="donut-wrapper">
                        <canvas id="healthDonutChart" width="130" height="130"></canvas>
                        <div class="donut-inner-stat">
                            <h4><%= stats.successRate || 0 %>%</h4>
                            <small>Recovery</small>
                        </div>
                    </div>
                </div>
                <div class="col-7">
                    <div class="cyber-legend-item">
                        <span class="text-muted d-flex align-items-center" style="font-size: 0.75rem;">
                            <span class="cyber-legend-dot dot-purple"></span> Active Lost
                        </span>
                        <span class="fw-bold text-white" style="font-size: 0.75rem;"><%= stats.lostItems || 0 %> items</span>
                    </div>
                    <div class="cyber-legend-item">
                        <span class="text-muted d-flex align-items-center" style="font-size: 0.75rem;">
                            <span class="cyber-legend-dot dot-green"></span> Secured Found
                        </span>
                        <span class="fw-bold text-white" style="font-size: 0.75rem;"><%= stats.foundItems || 0 %> items</span>
                    </div>
                    <div class="cyber-legend-item">
                        <span class="text-muted d-flex align-items-center" style="font-size: 0.75rem;">
                            <span class="cyber-legend-dot dot-cyan"></span> Claimed / Reunited
                        </span>
                        <span class="fw-bold text-white" style="font-size: 0.75rem;"><%= stats.claimedItems || 0 %> items</span>
                    </div>
                    <div class="cyber-legend-item">
                        <span class="text-muted d-flex align-items-center" style="font-size: 0.75rem;">
                            <span class="cyber-legend-dot dot-slate"></span> Pending Review
                        </span>
                        <span class="fw-bold text-white" style="font-size: 0.75rem;"><%= stats.pendingItems || 0 %> items</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Items by Campus Category (Horizontal Progress Gauges) -->
        <div class="cyber-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 fw-bold text-white font-sans" style="font-size: 0.85rem;">Items by Campus Category</h6>
                <span class="badge bg-dark border border-secondary text-muted" style="font-size: 0.68rem;">
                    <%= (typeof itemsByCategory !== 'undefined' && itemsByCategory.length > 0) ? itemsByCategory.length : 0 %> Categories
                </span>
            </div>

            <div class="cyber-gauges-container mt-1">
                <% 
                const categoriesToDisplay = (typeof itemsByCategory !== 'undefined' && itemsByCategory.length > 0)
                    ? itemsByCategory.slice(0, 5)
                    : [];
                const maxCatCount = Math.max(...categoriesToDisplay.map(c => c.count || 0), 1);
                %>
                <% if (categoriesToDisplay.length > 0) { %>
                    <% categoriesToDisplay.forEach(cat => { 
                        const pct = Math.max(Math.round(((cat.count || 0) / maxCatCount) * 100), (cat.count > 0 ? 15 : 4));
                    %>
                    <div class="cyber-gauge-row">
                        <div class="cyber-gauge-name" title="<%= cat.name %>">
                            <i class="fas <%= cat.icon ? cat.icon : 'fa-box' %> me-1 text-secondary"></i>
                            <%= cat.name %>
                        </div>
                        <div class="cyber-gauge-track">
                            <div class="cyber-gauge-fill" style="width: <%= pct %>%;">
                                <%= cat.count || 0 %>
                            </div>
                        </div>
                    </div>
                    <% }) %>

                    <div class="cyber-gauge-scale">
                        <span>0</span>
                        <span><%= Math.round(maxCatCount * 0.25) %></span>
                        <span><%= Math.round(maxCatCount * 0.5) %></span>
                        <span><%= Math.round(maxCatCount * 0.75) %></span>
                        <span><%= maxCatCount %></span>
                    </div>
                <% } else { %>
                    <div class="text-center py-4 text-muted small">
                        <i class="fas fa-tags mb-2 d-block fa-2x"></i>
                        No category data recorded yet.
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Bottom Full Width Card: Monthly Item Trends -->
    <div class="row g-2">
        <div class="col-12">
            <div class="cyber-card p-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                    <h6 class="mb-0 fw-bold text-white font-sans" style="font-size: 0.85rem;">Monthly Item &amp; Reunification Trends (Last 6 Months)</h6>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50" style="font-size: 0.68rem;">
                            <i class="fas fa-circle me-1" style="color: #8b5cf6; font-size: 0.5rem;"></i> Reported Items
                        </span>
                        <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50" style="font-size: 0.68rem;">
                            <i class="fas fa-circle me-1" style="color: #06b6d4; font-size: 0.5rem;"></i> Claimed &amp; Reunited
                        </span>
                    </div>
                </div>

                <div style="height: 180px; position: relative;">
                    <canvas id="monthlyCyberChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Health Summary Donut Chart
    const donutEl = document.getElementById('healthDonutChart');
    if (donutEl && typeof Chart !== 'undefined') {
        const donutCtx = donutEl.getContext('2d');
        const lost = <%= stats.lostItems || 0 %>;
        const found = <%= stats.foundItems || 0 %>;
        const claimed = <%= stats.claimedItems || 0 %>;
        const pending = <%= stats.pendingItems || 0 %>;
        const total = lost + found + claimed + pending;
        
        const chartData = total > 0 ? [lost, found, claimed, pending] : [1, 1, 1, 1];

        new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: ['Active Lost', 'Secured Found', 'Claimed & Reunited', 'Pending Approval'],
                datasets: [{
                    data: chartData,
                    backgroundColor: [
                        '#8b5cf6', // Purple
                        '#10b981', // Emerald Green
                        '#06b6d4', // Neon Cyan
                        '#334155'  // Dark Slate
                    ],
                    borderWidth: 0,
                    hoverOffset: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '74%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(15, 23, 42, 0.95)',
                        borderColor: 'rgba(255, 255, 255, 0.1)',
                        borderWidth: 1,
                        padding: 8,
                        titleColor: '#fff',
                        bodyColor: '#94a3b8'
                    }
                }
            }
        });
    }

    // 2. Monthly Dual Vertical Bar Chart
    const barEl = document.getElementById('monthlyCyberChart');
    if (barEl && typeof Chart !== 'undefined') {
        const barCtx = barEl.getContext('2d');
        
        <% 
        const mLabels = (typeof monthlyData !== 'undefined' && monthlyData.length > 0)
            ? monthlyData.map(d => `${d.month}`)
            : [];
        const mLost = (typeof monthlyData !== 'undefined' && monthlyData.length > 0)
            ? monthlyData.map(d => (d.lost || 0) + (d.found || 0))
            : [];
        const mClaimed = (typeof monthlyData !== 'undefined' && monthlyData.length > 0)
            ? monthlyData.map(d => d.claimed || 0)
            : [];
        %>

        const labels = <%- JSON.stringify(mLabels) %>;
        const lostData = <%- JSON.stringify(mLost) %>;
        const claimedData = <%- JSON.stringify(mClaimed) %>;

        // Gradient for Primary Purple Bars
        const purpleGrad = barCtx.createLinearGradient(0, 0, 0, 180);
        purpleGrad.addColorStop(0, '#8b5cf6');
        purpleGrad.addColorStop(1, 'rgba(139, 92, 246, 0.2)');

        // Gradient for Secondary Cyan Bars
        const cyanGrad = barCtx.createLinearGradient(0, 0, 0, 180);
        cyanGrad.addColorStop(0, '#06b6d4');
        cyanGrad.addColorStop(1, 'rgba(6, 182, 212, 0.2)');

        new Chart(barCtx, {
            type: 'bar',
            data: {
                labels: labels.length > 0 ? labels : ['No Data'],
                datasets: [
                    {
                        label: 'Reported Items',
                        data: lostData.length > 0 ? lostData : [0],
                        backgroundColor: purpleGrad,
                        borderRadius: 4,
                        barPercentage: 0.4,
                        categoryPercentage: 0.6
                    },
                    {
                        label: 'Claimed & Reunited',
                        data: claimedData.length > 0 ? claimedData : [0],
                        backgroundColor: cyanGrad,
                        borderRadius: 4,
                        barPercentage: 0.4,
                        categoryPercentage: 0.6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(15, 23, 42, 0.95)',
                        borderColor: 'rgba(255, 255, 255, 0.1)',
                        borderWidth: 1,
                        padding: 10,
                        titleColor: '#fff',
                        bodyColor: '#cbd5e1'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            color: '#64748b',
                            font: { size: 10 },
                            stepSize: 1
                        },
                        grid: {
                            color: 'rgba(255, 255, 255, 0.04)',
                            drawBorder: false
                        }
                    },
                    x: {
                        ticks: {
                            color: '#64748b',
                            font: { size: 10 }
                        },
                        grid: { display: false }
                    }
                }
            }
        });
    }
});
</script>
