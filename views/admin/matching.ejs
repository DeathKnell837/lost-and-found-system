<div class="dashboard-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-magic me-2"></i>Item Matching</h2>
            <p class="text-muted mb-0">Find potential matches between lost and found items</p>
        </div>
        <form action="/admin/matching/run" method="POST" class="d-inline">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-sync-alt me-2"></i>Run Matching Algorithm
            </button>
        </form>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">Lost Items</h6>
                            <h3 class="mb-0">
                                <%= stats.totalLost %>
                            </h3>
                        </div>
                        <i class="fas fa-exclamation-triangle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">Found Items</h6>
                            <h3 class="mb-0">
                                <%= stats.totalFound %>
                            </h3>
                        </div>
                        <i class="fas fa-hand-holding-heart fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white-50 mb-1">Stored Matches</h6>
                            <h3 class="mb-0">
                                <%= stats.withMatches %>
                            </h3>
                        </div>
                        <i class="fas fa-link fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-dark-50 mb-1">Match Pairs</h6>
                            <h3 class="mb-0">
                                <%= stats.totalPairs %>
                            </h3>
                        </div>
                        <i class="fas fa-exchange-alt fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scoring Legend -->
    <div class="card mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Score Breakdown</h5>
            <div>
                <span class="badge bg-success">70%+ Strong</span>
                <span class="badge bg-warning text-dark ms-1">40-69% Moderate</span>
                <span class="badge bg-secondary ms-1">30-39% Weak</span>
            </div>
        </div>
        <div class="card-body py-2">
            <div class="row text-center small align-items-center g-2">
                <div class="col"><span class="badge bg-primary">Category</span> 25%</div>
                <div class="col"><span class="badge bg-success">Location</span> 20%</div>
                <div class="col"><span class="badge bg-warning text-dark">Date/Time</span> 20%</div>
                <div class="col"><span class="badge bg-info">Name/Keywords</span> 20%</div>
                <div class="col"><span class="badge bg-secondary">Description</span> 15%</div>
                <div class="col"><span class="badge bg-dark" style="background: linear-gradient(135deg, #3b82f6, #06b6d4) !important;"><i class="fas fa-eye me-1"></i>CLIP Vision AI</span> 45% weight</div>
            </div>
        </div>
    </div>

    <!-- Filter Controls -->
    <div class="card mb-4">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-auto">
                    <label class="form-label mb-0 fw-bold"><i class="fas fa-filter me-1"></i> Min Score:</label>
                </div>
                <div class="col-md-3">
                    <select class="form-select form-select-sm" id="minScoreFilter" onchange="filterMatches()">
                        <option value="30">30%+ (All)</option>
                        <option value="40">40%+ (Moderate)</option>
                        <option value="50" selected>50%+ (Good)</option>
                        <option value="60">60%+ (Strong)</option>
                        <option value="70">70%+ (Very Strong)</option>
                    </select>
                </div>
                <div class="col-auto ms-auto">
                    <span class="text-muted" id="visibleCount">
                        <%= matchPairs.length %> pairs shown
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Match Pairs -->
    <div class="card">
        <div class="card-header bg-transparent">
            <h5 class="mb-0"><i class="fas fa-exchange-alt me-2"></i>Match Pairs (Lost ↔ Found)</h5>
        </div>
        <div class="card-body">
            <% if (matchPairs.length===0) { %>
                <div class="text-center py-5">
                    <i class="fas fa-search fa-4x text-muted mb-3"></i>
                    <h5>No Match Pairs Found</h5>
                    <p class="text-muted">Click "Run Matching Algorithm" or add items to find matches.</p>
                </div>
                <% } else { %>
                    <div id="matchPairsContainer">
                        <% matchPairs.forEach(function(pair, index) { %>
                            <div class="match-pair-card mb-4 border rounded-3 overflow-hidden"
                                data-score="<%= pair.score %>">
                                <!-- Score Header Bar -->
                                <div class="px-3 py-2 d-flex justify-content-between align-items-center"
                                    style="background: <%= pair.score >= 70 ? 'linear-gradient(135deg, #198754, #20c997)' : pair.score >= 40 ? 'linear-gradient(135deg, #ffc107, #fd7e14)' : 'linear-gradient(135deg, #6c757d, #adb5bd)' %>; color: white;">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold fs-5">
                                            <%= pair.score %>%
                                        </span>
                                        <span class="small opacity-75">match score</span>
                                    </div>
                                    <div class="d-flex gap-1 flex-wrap">
                                        <% pair.highlights.forEach(function(h) { %>
                                            <span class="badge bg-white text-dark" style="font-size: 0.7rem;">
                                                <%= h %>
                                            </span>
                                            <% }); %>
                                    </div>
                                </div>

                                <div class="row g-0">
                                    <!-- Lost Item (Left) -->
                                    <div class="col-md-5 p-3 border-end" style="background: rgba(220, 53, 69, 0.03);">
                                        <div class="d-flex align-items-start gap-2">
                                            <span class="badge bg-danger">LOST</span>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">
                                                    <%= pair.lostItem.itemName %>
                                                </h6>
                                                <div class="small text-muted">
                                                    <% if (pair.lostItem.category) { %>
                                                        <span><i
                                                                class="fas <%= pair.lostItem.category.icon || 'fa-box' %> me-1"></i>
                                                            <%= pair.lostItem.category.name %>
                                                        </span><br>
                                                        <% } %>
                                                            <span><i class="fas fa-map-marker-alt me-1"></i>
                                                                <%= pair.lostItem.location %>
                                                            </span><br>
                                                            <span><i class="fas fa-calendar me-1"></i>
                                                                <%= new
                                                                    Date(pair.lostItem.dateLostFound).toLocaleDateString()
                                                                    %>
                                                            </span>
                                                </div>
                                                <% if (pair.lostItem.imagePath) { %>
                                                    <img src="<%= pair.lostItem.imagePath %>"
                                                        class="img-fluid rounded mt-2"
                                                        style="max-height: 100px; object-fit: cover;">
                                                    <% } %>
                                                        <div class="mt-2">
                                                            <a href="/items/<%= pair.lostItem._id %>" target="_blank"
                                                                class="btn btn-sm btn-outline-danger">
                                                                <i class="fas fa-external-link-alt me-1"></i>View
                                                            </a>
                                                        </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Score Breakdown (Center) -->
                                    <div class="col-md-2 p-2 d-flex flex-column justify-content-center align-items-center"
                                        style="background: rgba(0,0,0,0.02);">
                                        <div class="w-100 px-1">
                                            <div class="mb-1">
                                                <div class="d-flex justify-content-between" style="font-size: 0.65rem;">
                                                    <span>Category</span><span>
                                                        <%= pair.breakdown.category %>
                                                    </span>
                                                </div>
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar bg-primary"
                                                        style="width: <%= (pair.breakdown.category / 25) * 100 %>%">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mb-1">
                                                <div class="d-flex justify-content-between" style="font-size: 0.65rem;">
                                                    <span>Location</span><span>
                                                        <%= pair.breakdown.location %>
                                                    </span>
                                                </div>
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar bg-success"
                                                        style="width: <%= (pair.breakdown.location / 20) * 100 %>%">
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mb-1">
                                                <div class="d-flex justify-content-between" style="font-size: 0.65rem;">
                                                    <span>Date</span><span>
                                                        <%= pair.breakdown.date %>
                                                    </span>
                                                </div>
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar bg-warning"
                                                        style="width: <%= (pair.breakdown.date / 20) * 100 %>%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-1">
                                                <div class="d-flex justify-content-between" style="font-size: 0.65rem;">
                                                    <span>Name</span><span>
                                                        <%= pair.breakdown.name %>
                                                    </span>
                                                </div>
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar bg-info"
                                                        style="width: <%= (pair.breakdown.name / 20) * 100 %>%"></div>
                                                </div>
                                            </div>
                                            <div class="mb-1">
                                                <div class="d-flex justify-content-between" style="font-size: 0.65rem;">
                                                    <span>Desc</span><span>
                                                        <%= pair.breakdown.description %>
                                                    </span>
                                                </div>
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar bg-secondary"
                                                        style="width: <%= (pair.breakdown.description / 15) * 100 %>%">
                                                    </div>
                                                </div>
                                            </div>
                                            <% if (pair.breakdown.keywords> 0) { %>
                                                <div class="mb-1">
                                                    <div class="d-flex justify-content-between"
                                                        style="font-size: 0.65rem;">
                                                        <span>Bonus</span><span>+<%= pair.breakdown.keywords %></span>
                                                    </div>
                                                    <div class="progress" style="height: 4px;">
                                                        <div class="progress-bar bg-dark"
                                                            style="width: <%= (pair.breakdown.keywords / 10) * 100 %>%">
                                                        </div>
                                                    </div>
                                                </div>
                                                <% } %>
                                        </div>
                                    </div>

                                    <!-- Found Item (Right) -->
                                    <div class="col-md-5 p-3" style="background: rgba(25, 135, 84, 0.03);">
                                        <div class="d-flex align-items-start gap-2">
                                            <span class="badge bg-success">FOUND</span>
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1">
                                                    <%= pair.foundItem.itemName %>
                                                </h6>
                                                <div class="small text-muted">
                                                    <% if (pair.foundItem.category) { %>
                                                        <span><i
                                                                class="fas <%= pair.foundItem.category.icon || 'fa-box' %> me-1"></i>
                                                            <%= pair.foundItem.category.name %>
                                                        </span><br>
                                                        <% } %>
                                                            <span><i class="fas fa-map-marker-alt me-1"></i>
                                                                <%= pair.foundItem.location %>
                                                            </span><br>
                                                            <span><i class="fas fa-calendar me-1"></i>
                                                                <%= new
                                                                    Date(pair.foundItem.dateLostFound).toLocaleDateString()
                                                                    %>
                                                            </span>
                                                </div>
                                                <% if (pair.foundItem.imagePath) { %>
                                                    <img src="<%= pair.foundItem.imagePath %>"
                                                        class="img-fluid rounded mt-2"
                                                        style="max-height: 100px; object-fit: cover;">
                                                    <% } %>
                                                        <div class="mt-2">
                                                            <a href="/items/<%= pair.foundItem._id %>" target="_blank"
                                                                class="btn btn-sm btn-outline-success">
                                                                <i class="fas fa-external-link-alt me-1"></i>View
                                                            </a>
                                                        </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
        </div>
    </div>
</div>

<script>
    function filterMatches() {
        var minScore = parseInt(document.getElementById('minScoreFilter').value);
        var cards = document.querySelectorAll('.match-pair-card');
        var visibleCount = 0;
        cards.forEach(function (card) {
            var score = parseInt(card.getAttribute('data-score'));
            if (score >= minScore) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });
        document.getElementById('visibleCount').textContent = visibleCount + ' pairs shown';
    }
    // Apply default filter on page load
    document.addEventListener('DOMContentLoaded', filterMatches);
</script>