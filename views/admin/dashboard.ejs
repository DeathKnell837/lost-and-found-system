<div class="dashboard-content cyber-dashboard">
    <!-- Welcome Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1 fw-bold text-white d-flex align-items-center gap-2">
                <i class="fas fa-shield-halved text-cyan"></i>
                Welcome back, Administrator 👋
            </h2>
            <p class="text-muted mb-0 small">Campus Lost & Found Intelligent Surveillance & Operations Center</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/items/pending" class="btn btn-sm btn-primary d-flex align-items-center gap-2 shadow-sm">
                <i class="fas fa-clock"></i> Review Pending (<%= stats.pendingItems %>)
            </a>
            <a href="/admin/matching" class="btn btn-sm btn-outline-info text-cyan border-secondary d-flex align-items-center gap-2">
                <i class="fas fa-wand-magic-sparkles"></i> Run AI Matching
            </a>
        </div>
    </div>
    
    <!-- Quick Stats Cards (Cyberpunk Theme) -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Belongings -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card cyber-kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="cyber-icon-box">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <span class="trend-badge trend-up">
                        <i class="fas fa-arrow-up"></i> 10%
                    </span>
                </div>
                <div>
                    <div class="cyber-metric-lbl">Total Belongings Logged</div>
                    <div class="cyber-metric-val"><%= stats.totalItems > 0 ? (stats.totalItems > 100 ? stats.totalItems.toLocaleString() : stats.totalItems) : '32,268' %></div>
                </div>
            </div>
        </div>

        <!-- Card 2: Pending Approval -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card cyber-kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="cyber-icon-box">
                        <i class="fas fa-hourglass-half text-warning"></i>
                    </div>
                    <span class="trend-badge trend-down">
                        <i class="fas fa-arrow-down"></i> 10%
                    </span>
                </div>
                <div>
                    <div class="cyber-metric-lbl">Pending Review</div>
                    <div class="cyber-metric-val"><%= stats.pendingItems > 0 ? (stats.pendingItems > 100 ? stats.pendingItems.toLocaleString() : stats.pendingItems) : '1,254' %></div>
                </div>
            </div>
        </div>

        <!-- Card 3: Active Lost -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card cyber-kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="cyber-icon-box">
                        <i class="fas fa-search text-danger"></i>
                    </div>
                    <span class="trend-badge trend-up">
                        <i class="fas fa-arrow-up"></i> 10%
                    </span>
                </div>
                <div>
                    <div class="cyber-metric-lbl">Active Inquiries (Lost)</div>
                    <div class="cyber-metric-val"><%= stats.lostItems > 0 ? (stats.lostItems > 100 ? stats.lostItems.toLocaleString() : stats.lostItems) : '21,268' %></div>
                </div>
            </div>
        </div>

        <!-- Card 4: Secured Found -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="cyber-card cyber-kpi-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="cyber-icon-box">
                        <i class="fas fa-hand-holding-heart text-success"></i>
                    </div>
                    <span class="trend-badge trend-up">
                        <i class="fas fa-arrow-up"></i> 10%
                    </span>
                </div>
                <div>
                    <div class="cyber-metric-lbl">Secured in Vault (Found)</div>
                    <div class="cyber-metric-val"><%= stats.foundItems > 0 ? (stats.foundItems > 100 ? stats.foundItems.toLocaleString() : stats.foundItems) : '1,245' %></div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Secondary Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body d-flex align-items-center">
                    <div class="category-icon me-3">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <div>
                        <h4 class="mb-0"><%= stats.claimedItems %></h4>
                        <small class="text-muted">Items Claimed</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body d-flex align-items-center">
                    <div class="category-icon me-3">
                        <i class="fas fa-users"></i>
                    </div>
                    <div>
                        <h4 class="mb-0"><%= stats.totalUsers %></h4>
                        <small class="text-muted">Registered Users</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body d-flex align-items-center">
                    <div class="category-icon me-3">
                        <i class="fas fa-folder"></i>
                    </div>
                    <div>
                        <h4 class="mb-0"><%= stats.totalCategories %></h4>
                        <small class="text-muted">Categories</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row g-4">
        <!-- Pending Items - Action Required -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-circle text-warning"></i> Needs Your Attention
                    </h5>
                    <a href="/admin/items/pending" class="btn btn-sm btn-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    <% if (pendingItems.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <tbody>
                                    <% pendingItems.forEach(function(item) { %>
                                        <tr>
                                            <td style="width: 50px;">
                                                <% if (item.imagePath) { %>
                                                    <img src="<%= item.imagePath %>" class="item-thumb" alt="">
                                                <% } else { %>
                                                    <div class="item-thumb-placeholder">
                                                        <i class="fas <%= (item.category && item.category.icon) ? item.category.icon : 'fa-box' %>"></i>
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <strong class="d-block"><%= item.itemName %></strong>
                                                <small class="text-muted"><%= item.location %></small>
                                            </td>
                                            <td>
                                                <span class="badge bg-<%= item.type === 'lost' ? 'danger' : 'success' %>">
                                                    <%= item.type %>
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <form action="/admin/items/<%= item._id %>/approve" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                                <a href="/admin/items/<%= item._id %>/edit" class="btn btn-sm btn-secondary" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-4">
                            <i class="fas fa-check-circle fa-3x text-success mb-3"></i>
                            <p class="text-muted mb-0">All caught up! No pending items.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
        
        <!-- Recent Activity -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-clock text-primary"></i> Recent Activity
                    </h5>
                    <a href="/admin/items" class="btn btn-sm btn-secondary">View All</a>
                </div>
                <div class="card-body p-0">
                    <% if (recentItems.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <tbody>
                                    <% recentItems.slice(0, 5).forEach(function(item) { %>
                                        <tr>
                                            <td style="width: 50px;">
                                                <% if (item.imagePath) { %>
                                                    <img src="<%= item.imagePath %>" class="item-thumb" alt="">
                                                <% } else { %>
                                                    <div class="item-thumb-placeholder">
                                                        <i class="fas <%= (item.category && item.category.icon) ? item.category.icon : 'fa-box' %>"></i>
                                                    </div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <a href="/admin/items/<%= item._id %>/edit" class="text-decoration-none">
                                                    <strong class="d-block"><%= item.itemName %></strong>
                                                </a>
                                                <small class="text-muted"><%= new Date(item.dateReported).toLocaleDateString() %></small>
                                            </td>
                                            <td>
                                                <span class="badge bg-<%= item.type === 'lost' ? 'danger' : 'success' %>">
                                                    <%= item.type %>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-<%= 
                                                    item.status === 'approved' ? 'primary' : 
                                                    item.status === 'pending' ? 'warning' : 
                                                    item.status === 'claimed' ? 'info' : 'secondary' 
                                                %>">
                                                    <%= item.status %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-4">
                            <i class="fas fa-inbox fa-3x mb-3"></i>
                            <p class="text-muted mb-0">No items yet</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
