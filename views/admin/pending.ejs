<div class="cyber-dashboard">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-white d-flex align-items-center gap-2" style="letter-spacing: -0.02em;">
                <i class="fas fa-clock text-warning"></i>
                Pending Verification Queue
            </h4>
            <span class="text-muted small" style="font-size: 0.76rem;">Review and approve student-submitted lost and found reports before public listing</span>
        </div>
        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 py-1 px-3" style="font-size: 0.76rem;">
            <%= items.length %> Awaiting Approval
        </span>
    </div>
    
    <% if (items.length > 0) { %>
        <div class="row g-2">
            <% items.forEach(function(item) { %>
                <div class="col-12 col-md-6">
                    <div class="cyber-card p-3 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-start gap-3 mb-2">
                                <!-- Image Thumbnail -->
                                <div style="width: 72px; height: 72px; flex-shrink: 0;">
                                    <% if (item.imagePath) { %>
                                        <img src="<%= item.imagePath %>" class="cyber-thumb w-100 h-100" alt="<%= item.itemName %>">
                                    <% } else { %>
                                        <div class="cyber-thumb-placeholder w-100 h-100" style="font-size: 1.5rem;">
                                            <i class="fas <%= (item.category && item.category.icon) ? item.category.icon : 'fa-box' %>"></i>
                                        </div>
                                    <% } %>
                                </div>
                                
                                <!-- Details -->
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="cyber-badge <%= item.type === 'lost' ? 'cyber-badge-lost' : 'cyber-badge-found' %>">
                                            <i class="fas <%= item.type === 'lost' ? 'fa-exclamation-triangle' : 'fa-check-circle' %>"></i>
                                            <%= item.type %>
                                        </span>
                                        <small class="text-muted" style="font-size: 0.7rem;">
                                            <i class="fas fa-calendar me-1"></i><%= new Date(item.dateReported).toLocaleDateString() %>
                                        </small>
                                    </div>
                                    
                                    <h6 class="text-white mb-1 text-truncate" style="font-size: 0.9rem;"><%= item.itemName %></h6>
                                    
                                    <div class="text-muted" style="font-size: 0.72rem; line-height: 1.4;">
                                        <div><i class="fas fa-map-marker-alt me-1 text-secondary"></i><%= item.location %></div>
                                        <div><i class="fas fa-user me-1 text-secondary"></i><%= item.reporterName %> (<%= item.reporterEmail %>)</div>
                                    </div>
                                </div>
                            </div>
                            
                            <% if (item.description) { %>
                                <p class="text-muted small mb-3 p-2 rounded-2" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); font-size: 0.72rem;">
                                    <%= item.description.substring(0, 120) %><%= item.description.length > 120 ? '...' : '' %>
                                </p>
                            <% } %>
                        </div>
                        
                        <!-- Actions Footer -->
                        <div class="d-flex gap-2 pt-2" style="border-top: 1px solid rgba(255,255,255,0.06);">
                            <form action="/admin/items/<%= item._id %>/approve" method="POST" class="flex-grow-1 mb-0">
                                <button type="submit" class="btn btn-sm btn-success w-100 py-1" style="font-size: 0.76rem;">
                                    <i class="fas fa-check me-1"></i> Approve
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-danger py-1 px-3" style="font-size: 0.76rem;" data-bs-toggle="modal" data-bs-target="#rejectModal<%= item._id %>">
                                <i class="fas fa-times me-1"></i> Reject
                            </button>
                            <a href="/admin/items/<%= item._id %>/edit" class="btn btn-sm btn-outline-light border-secondary py-1 px-2" style="font-size: 0.76rem;" title="Inspect Details">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </div>
                    
                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectModal<%= item._id %>" tabindex="-1">
                        <div class="modal-dialog modal-sm modal-dialog-centered">
                            <div class="modal-content cyber-card">
                                <form action="/admin/items/<%= item._id %>/reject" method="POST">
                                    <div class="modal-header py-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                        <h6 class="modal-title small fw-bold">Reject Item Report</h6>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body py-2 text-start">
                                        <p class="small mb-2">Rejecting report: <strong class="text-white"><%= item.itemName %></strong></p>
                                        <textarea class="form-control cyber-select py-1 px-2" name="reason" rows="2" 
                                                  placeholder="Reason for rejection..."></textarea>
                                    </div>
                                    <div class="modal-footer py-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
                                        <button type="button" class="btn btn-sm btn-outline-light border-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="cyber-card p-5 text-center">
            <div class="cyber-thumb-placeholder mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.8rem; background: rgba(16, 185, 129, 0.08); border-color: rgba(16, 185, 129, 0.2);">
                <i class="fas fa-check-circle text-success"></i>
            </div>
            <h5 class="text-white mb-1">Queue is Clear!</h5>
            <p class="text-muted small mb-3">All reported lost and found belongings have been reviewed and processed.</p>
            <a href="/admin/items" class="btn btn-sm btn-outline-info text-cyan border-secondary py-1 px-3" style="font-size: 0.76rem;">
                <i class="fas fa-boxes me-1"></i> View All Items
            </a>
        </div>
    <% } %>
</div>
