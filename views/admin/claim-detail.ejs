<div class="cyber-dashboard">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1" style="font-size: 0.72rem;">
                <a href="/admin/dashboard" class="text-muted text-decoration-none">Dashboard</a>
                <span class="text-secondary">/</span>
                <a href="/admin/claims" class="text-muted text-decoration-none">Claims</a>
                <span class="text-secondary">/</span>
                <span class="text-cyan">Review Claim</span>
            </div>
            <h4 class="mb-0 fw-bold text-white d-flex align-items-center gap-2" style="letter-spacing: -0.02em;">
                <i class="fas fa-hand-holding text-cyan"></i>
                Claim Ownership Verification
            </h4>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="cyber-badge <%= 
                claim.status === 'pending' ? 'cyber-badge-pending' : 
                claim.status === 'under_review' ? 'cyber-badge-claimed' : 
                claim.status === 'approved' ? 'cyber-badge-found' : 'cyber-badge-lost' 
            %>">
                <%= claim.status.replace('_', ' ').toUpperCase() %>
            </span>
            <span class="badge bg-dark border border-secondary text-white" style="font-size: 0.72rem;">
                <%= claim.priority.toUpperCase() %> PRIORITY
            </span>
        </div>
    </div>

    <div class="row g-3">
        <!-- Main Content (Left) -->
        <div class="col-12 col-lg-8">
            <!-- Header Summary Card -->
            <div class="cyber-card p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small" style="font-size: 0.72rem;">Claimant Information</span>
                        <h6 class="text-white mb-0 fw-bold"><%= claim.claimant.username %> (<%= claim.claimant.email %>)</h6>
                    </div>
                    <span class="text-muted small" style="font-size: 0.72rem;">
                        <i class="fas fa-calendar me-1"></i> Submitted: <%= new Date(claim.createdAt).toLocaleDateString() %>
                    </span>
                </div>
            </div>

            <!-- Claim Description -->
            <div class="cyber-card p-3 mb-3">
                <h6 class="text-white mb-2 fw-bold d-flex align-items-center gap-2" style="font-size: 0.82rem;">
                    <i class="fas fa-comment-alt text-cyan"></i> Claimant Statement &amp; Context
                </h6>
                <div class="p-2 rounded-2 text-white-50" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); font-size: 0.8rem; line-height: 1.5;">
                    <%= claim.description || 'No additional statement provided.' %>
                </div>
            </div>

            <!-- Proof of Ownership -->
            <div class="cyber-card p-3 mb-3">
                <h6 class="text-white mb-2 fw-bold d-flex align-items-center gap-2" style="font-size: 0.82rem;">
                    <i class="fas fa-certificate text-success"></i> Proof of Ownership Details
                </h6>
                <div class="p-2 rounded-2 text-white-50 mb-2" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); font-size: 0.8rem; line-height: 1.5;">
                    <%= claim.proofOfOwnership || 'No detailed proof specified.' %>
                </div>
                
                <% if (claim.identifyingFeatures) { %>
                    <h6 class="text-white mt-3 mb-1" style="font-size: 0.76rem;">Unique Identifying Features</h6>
                    <div class="p-2 rounded-2 text-info" style="background: rgba(6, 182, 212, 0.05); border: 1px solid rgba(6, 182, 212, 0.15); font-size: 0.76rem;">
                        <%= claim.identifyingFeatures %>
                    </div>
                <% } %>

                <% if (claim.proofImages && claim.proofImages.length > 0) { %>
                    <h6 class="text-white mt-3 mb-2" style="font-size: 0.76rem;">Attached Proof Images</h6>
                    <div class="d-flex gap-2 flex-wrap">
                        <% claim.proofImages.forEach(img => { %>
                            <img src="<%= img.url %>" class="cyber-thumb" style="width: 80px; height: 80px; cursor: pointer;" onclick="window.open('<%= img.url %>')">
                        <% }); %>
                    </div>
                <% } %>
            </div>

            <!-- Action Form -->
            <% if (['pending', 'under_review'].includes(claim.status)) { %>
                <div class="cyber-card p-3 mb-3">
                    <h6 class="text-white mb-3 fw-bold d-flex align-items-center gap-2" style="font-size: 0.82rem;">
                        <i class="fas fa-gavel text-warning"></i> Authorize &amp; Process Decision
                    </h6>
                    
                    <form action="/admin/claims/<%= claim._id %>/status" method="POST">
                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Decision Action</label>
                            <select name="status" id="statusSelect" class="form-select cyber-select py-1 px-2" required style="font-size: 0.76rem;">
                                <option value="">Select decision action...</option>
                                <option value="under_review">Mark as Under Verification Review</option>
                                <option value="approved">Approve Claim &amp; Release Custody</option>
                                <option value="rejected">Reject Claim</option>
                            </select>
                        </div>

                        <div class="mb-3" id="rejectionReasonDiv" style="display: none;">
                            <label class="form-label text-danger small mb-1" style="font-size: 0.72rem;">Rejection Reason</label>
                            <textarea name="rejectionReason" class="form-control cyber-select py-1 px-2" rows="2" placeholder="Explain why the claim is being rejected..." style="font-size: 0.76rem;"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Internal Admin Notes</label>
                            <textarea name="adminNotes" class="form-control cyber-select py-1 px-2" rows="2" placeholder="Optional notes for internal record keeping..." style="font-size: 0.76rem;"><%= claim.adminNotes || '' %></textarea>
                        </div>

                        <button type="submit" class="btn btn-sm btn-primary py-1 px-3" style="font-size: 0.76rem;">
                            <i class="fas fa-check me-1"></i> Submit Decision
                        </button>
                    </form>
                </div>
            <% } %>

            <!-- Timeline -->
            <div class="cyber-card p-3">
                <h6 class="text-white mb-3 fw-bold d-flex align-items-center gap-2" style="font-size: 0.82rem;">
                    <i class="fas fa-history text-cyan"></i> Audit Log &amp; Timeline
                </h6>
                <div class="d-flex flex-column gap-2">
                    <% if (claim.timeline && claim.timeline.length > 0) { %>
                        <% claim.timeline.slice().reverse().forEach(event => { %>
                            <div class="d-flex align-items-start gap-2 p-2 rounded-2" style="background: rgba(255,255,255,0.02); border-left: 2px solid #06b6d4;">
                                <div class="flex-grow-1 min-w-0">
                                    <strong class="text-white d-block" style="font-size: 0.76rem;"><%= event.action %></strong>
                                    <span class="text-muted" style="font-size: 0.68rem;"><%= new Date(event.timestamp).toLocaleString() %></span>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-muted small mb-0">No timeline history recorded.</p>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Sidebar Info (Right) -->
        <div class="col-12 col-lg-4">
            <!-- Item Being Claimed -->
            <div class="cyber-card p-3 mb-3">
                <h6 class="text-white mb-3 fw-bold d-flex align-items-center gap-2" style="font-size: 0.82rem;">
                    <i class="fas fa-box text-cyan"></i> Item In Custody
                </h6>
                <% if (claim.item) { %>
                    <div class="d-flex align-items-start gap-2 mb-2">
                        <% if (claim.item.imagePath || claim.item.image) { %>
                            <img src="<%= claim.item.imagePath || claim.item.image %>" class="cyber-thumb" style="width: 50px; height: 50px;">
                        <% } else { %>
                            <div class="cyber-thumb-placeholder" style="width: 50px; height: 50px; font-size: 1.2rem;">
                                <i class="fas fa-box"></i>
                            </div>
                        <% } %>
                        <div class="flex-grow-1 min-w-0">
                            <strong class="text-white d-block text-truncate" style="font-size: 0.82rem;"><%= claim.item.itemName || claim.item.title %></strong>
                            <div class="text-muted" style="font-size: 0.7rem;">
                                <div><i class="fas fa-map-marker-alt me-1 text-secondary"></i><%= claim.item.location %></div>
                            </div>
                        </div>
                    </div>
                    <a href="/admin/items/<%= claim.item._id %>/edit" class="btn btn-sm btn-outline-light border-secondary w-100 py-1" style="font-size: 0.72rem;">
                        <i class="fas fa-external-link-alt me-1"></i> Inspect Item Details
                    </a>
                <% } else { %>
                    <p class="text-muted small mb-0">Item record removed.</p>
                <% } %>
            </div>

            <!-- Priority Selector -->
            <div class="cyber-card p-3 mb-3">
                <h6 class="text-white mb-2 fw-bold d-flex align-items-center gap-2" style="font-size: 0.82rem;">
                    <i class="fas fa-flag text-warning"></i> Set Priority
                </h6>
                <form action="/admin/claims/<%= claim._id %>/priority" method="POST">
                    <div class="btn-group w-100">
                        <button type="submit" name="priority" value="low" class="btn btn-sm <%= claim.priority === 'low' ? 'btn-secondary' : 'btn-outline-secondary' %>" style="font-size: 0.72rem;">Low</button>
                        <button type="submit" name="priority" value="normal" class="btn btn-sm <%= claim.priority === 'normal' ? 'btn-warning text-dark' : 'btn-outline-warning' %>" style="font-size: 0.72rem;">Normal</button>
                        <button type="submit" name="priority" value="high" class="btn btn-sm <%= claim.priority === 'high' ? 'btn-danger' : 'btn-outline-danger' %>" style="font-size: 0.72rem;">High</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('statusSelect')?.addEventListener('change', function() {
        const rejDiv = document.getElementById('rejectionReasonDiv');
        rejDiv.style.display = this.value === 'rejected' ? 'block' : 'none';
    });
</script>
