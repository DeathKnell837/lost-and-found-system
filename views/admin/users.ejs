<div class="cyber-dashboard">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-white d-flex align-items-center gap-2" style="letter-spacing: -0.02em;">
                <i class="fas fa-users text-cyan"></i>
                Users &amp; Access Control
            </h4>
            <span class="text-muted small" style="font-size: 0.76rem;">Manage registered campus students, staff accounts, and administrative roles</span>
        </div>
        <span class="badge bg-primary bg-opacity-25 text-cyan border border-info border-opacity-50 py-1 px-3" style="font-size: 0.76rem;">
            <%= totalUsers %> Total Users
        </span>
    </div>

    <!-- Users Table Card -->
    <div class="cyber-card p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 fw-bold text-white d-flex align-items-center gap-2" style="font-size: 0.85rem;">
                <i class="fas fa-list text-cyan"></i> Registered Accounts
            </h6>
            <% if (totalPages > 1) { %>
                <span class="text-muted small" style="font-size: 0.72rem;">Page <%= currentPage %> of <%= totalPages %></span>
            <% } %>
        </div>

        <% if (users.length > 0) { %>
            <div class="table-responsive">
                <table class="cyber-table">
                    <thead>
                        <tr>
                            <th>User Account</th>
                            <th>Email Address</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Joined</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(function(u) { %>
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="cyber-thumb-placeholder me-2" style="width: 32px; height: 32px; font-size: 0.9rem;">
                                            <i class="fas fa-user text-secondary"></i>
                                        </div>
                                        <strong class="text-white"><%= u.username %></strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted" style="font-size: 0.76rem;"><%= u.email %></span>
                                </td>
                                <td>
                                    <span class="badge <%= u.role === 'admin' ? 'bg-danger text-white' : 'bg-primary bg-opacity-25 text-cyan border border-info border-opacity-50' %>" style="font-size: 0.68rem;">
                                        <%= u.role.toUpperCase() %>
                                    </span>
                                </td>
                                <td>
                                    <span class="cyber-badge <%= u.isActive ? 'cyber-badge-found' : 'cyber-badge-lost' %>" style="font-size: 0.68rem;">
                                        <%= u.isActive ? 'ACTIVE' : 'DEACTIVATED' %>
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted"><%= new Date(u.createdAt).toLocaleDateString() %></small>
                                </td>
                                <td class="text-end">
                                    <% if (u._id.toString() !== (admin && admin.id ? admin.id.toString() : '')) { %>
                                        <form action="/admin/users/<%= u._id %>/toggle" method="POST" class="d-inline mb-0">
                                            <button type="submit" class="btn btn-sm <%= u.isActive ? 'btn-outline-warning' : 'btn-outline-success' %> py-0 px-2" style="font-size: 0.7rem;">
                                                <i class="fas fa-<%= u.isActive ? 'ban' : 'check' %> me-1"></i>
                                                <%= u.isActive ? 'Deactivate' : 'Activate' %>
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span class="badge bg-dark border border-secondary text-muted" style="font-size: 0.68rem;">Current Admin</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="d-flex justify-content-center mt-3 pt-2" style="border-top: 1px solid rgba(255,255,255,0.06);">
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= i %>" style="background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.1); color: #cbd5e1;"><%= i %></a>
                                </li>
                            <% } %>
                        </ul>
                    </nav>
                </div>
            <% } %>
        <% } else { %>
            <div class="text-center py-5">
                <div class="cyber-thumb-placeholder mx-auto mb-2" style="width: 50px; height: 50px; font-size: 1.3rem;">
                    <i class="fas fa-users text-muted"></i>
                </div>
                <p class="text-muted small mb-0">No user accounts registered.</p>
            </div>
        <% } %>
    </div>
</div>