<div class="cyber-dashboard">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-white d-flex align-items-center gap-2" style="letter-spacing: -0.02em;">
                <i class="fas fa-tags text-cyan"></i>
                Campus Belonging Categories
            </h4>
            <span class="text-muted small" style="font-size: 0.76rem;">Configure item taxonomy, icons, and classifications</span>
        </div>
        <button class="btn btn-sm btn-primary py-1 px-3 d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal" style="font-size: 0.76rem;">
            <i class="fas fa-plus"></i> Add New Category
        </button>
    </div>
    
    <div class="row g-2">
        <% categories.forEach(function(cat) { %>
            <div class="col-12 col-md-6 col-lg-4">
                <div class="cyber-card p-3 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center mb-2">
                            <div class="cyber-thumb-placeholder me-2" style="width: 44px; height: 44px; font-size: 1.2rem; background: rgba(6, 182, 212, 0.08); border-color: rgba(6, 182, 212, 0.2);">
                                <i class="fas <%= cat.icon || 'fa-box' %> text-cyan"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <h6 class="text-white mb-0 text-truncate fw-bold" style="font-size: 0.85rem;"><%= cat.name %></h6>
                                <span class="text-muted small" style="font-size: 0.7rem;"><%= cat.itemCount %> recorded items</span>
                            </div>
                            <span class="cyber-badge <%= cat.isActive ? 'cyber-badge-found' : 'cyber-badge-lost' %>" style="font-size: 0.65rem;">
                                <%= cat.isActive ? 'ACTIVE' : 'INACTIVE' %>
                            </span>
                        </div>
                        <% if (cat.description) { %>
                            <p class="text-muted small mb-3 p-2 rounded-2" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); font-size: 0.72rem; line-height: 1.4;">
                                <%= cat.description %>
                            </p>
                        <% } %>
                    </div>
                    <div class="d-flex gap-2 pt-2" style="border-top: 1px solid rgba(255,255,255,0.06);">
                        <button class="btn btn-sm btn-outline-light border-secondary flex-grow-1 py-1" style="font-size: 0.72rem;"
                                data-bs-toggle="modal" data-bs-target="#editModal<%= cat._id %>">
                            <i class="fas fa-edit me-1"></i> Edit Category
                        </button>
                        <% if (cat.itemCount === 0) { %>
                            <button class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.72rem;"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal<%= cat._id %>" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        <% } %>
                    </div>
                </div>
                
                <!-- Edit Modal -->
                <div class="modal fade" id="editModal<%= cat._id %>" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content cyber-card">
                            <form action="/admin/categories/<%= cat._id %>" method="POST">
                                <div class="modal-header py-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                    <h6 class="modal-title small fw-bold">Edit Category</h6>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body py-3">
                                    <div class="mb-2">
                                        <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Category Name</label>
                                        <input type="text" class="form-control cyber-select py-1 px-2" name="name" 
                                               value="<%= cat.name %>" required style="font-size: 0.76rem;">
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Description</label>
                                        <textarea class="form-control cyber-select py-1 px-2" name="description" rows="2" style="font-size: 0.76rem;"><%= cat.description || '' %></textarea>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Icon Class (Font Awesome)</label>
                                        <input type="text" class="form-control cyber-select py-1 px-2" name="icon" 
                                               value="<%= cat.icon || '' %>" placeholder="e.g., fa-laptop" style="font-size: 0.76rem;">
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Status</label>
                                        <select class="form-select cyber-select py-1 px-2" name="isActive" style="font-size: 0.76rem;">
                                            <option value="true" <%= cat.isActive ? 'selected' : '' %>>Active</option>
                                            <option value="false" <%= !cat.isActive ? 'selected' : '' %>>Inactive</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="modal-footer py-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
                                    <button type="button" class="btn btn-sm btn-outline-light border-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-sm btn-primary">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                
                <!-- Delete Modal -->
                <div class="modal fade" id="deleteModal<%= cat._id %>" tabindex="-1">
                    <div class="modal-dialog modal-sm modal-dialog-centered">
                        <div class="modal-content cyber-card">
                            <div class="modal-header py-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                                <h6 class="modal-title small fw-bold">Delete Category</h6>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body py-2">
                                <p class="small mb-1">Delete category <strong class="text-white"><%= cat.name %></strong>?</p>
                                <p class="text-danger small mb-0" style="font-size: 0.7rem;">This cannot be undone.</p>
                            </div>
                            <div class="modal-footer py-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
                                <button type="button" class="btn btn-sm btn-outline-light border-secondary" data-bs-dismiss="modal">Cancel</button>
                                <form action="/admin/categories/<%= cat._id %>/delete" method="POST" class="d-inline mb-0">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cyber-card">
            <form action="/admin/categories" method="POST">
                <div class="modal-header py-2" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                    <h6 class="modal-title small fw-bold">Add New Category</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-2">
                        <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Category Name</label>
                        <input type="text" class="form-control cyber-select py-1 px-2" name="name" required 
                               placeholder="e.g., Electronics & Gadgets" style="font-size: 0.76rem;">
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Description</label>
                        <textarea class="form-control cyber-select py-1 px-2" name="description" rows="2" 
                                  placeholder="Brief description of this item category..." style="font-size: 0.76rem;"></textarea>
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-muted small mb-1" style="font-size: 0.72rem;">Icon Class (Font Awesome Free)</label>
                        <input type="text" class="form-control cyber-select py-1 px-2" name="icon" 
                               placeholder="e.g., fa-laptop, fa-key, fa-id-card" style="font-size: 0.76rem;">
                    </div>
                </div>
                <div class="modal-footer py-2" style="border-top: 1px solid rgba(255,255,255,0.08);">
                    <button type="button" class="btn btn-sm btn-outline-light border-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary">Add Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
