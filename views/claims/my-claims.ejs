<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-hand-holding me-2"></i>My Claims</h2>
            <p class="text-muted mb-0">Track the status of your claim requests</p>
        </div>
    </div>

    <% if (claims.length === 0) { %>
        <div class="card shadow">
            <div class="card-body text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h4>No Claims Yet</h4>
                <p class="text-muted">You haven't submitted any claim requests yet.</p>
                <a href="/items/found" class="btn btn-primary">
                    <i class="fas fa-search me-2"></i>Browse Found Items
                </a>
            </div>
        </div>
    <% } else { %>
        <!-- Status Filter Tabs -->
        <ul class="nav nav-pills mb-4" id="claimTabs">
            <li class="nav-item">
                <button class="nav-link active" data-filter="all">
                    All <span class="badge bg-secondary ms-1"><%= claims.length %></span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-filter="pending">
                    Pending <span class="badge bg-warning text-dark ms-1"><%= claims.filter(c => c.status === 'pending').length %></span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-filter="under_review">
                    Under Review <span class="badge bg-info ms-1"><%= claims.filter(c => c.status === 'under_review').length %></span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-filter="approved">
                    Approved <span class="badge bg-success ms-1"><%= claims.filter(c => c.status === 'approved').length %></span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-filter="rejected">
                    Rejected <span class="badge bg-danger ms-1"><%= claims.filter(c => c.status === 'rejected').length %></span>
                </button>
            </li>
        </ul>

        <!-- Claims List -->
        <% claims.forEach(claim => { %>
            <div class="card shadow-sm mb-3 claim-card" data-status="<%= claim.status %>">
                <div class="card-body">
                    <div class="d-flex">
                        <!-- Item Image -->
                        <div class="me-3" style="flex-shrink: 0;">
                            <% if (claim.item && claim.item.imagePath) { %>
                                <img src="<%= claim.item.imagePath %>" alt="" class="rounded" style="width: 80px; height: 80px; object-fit: cover;">
                            <% } else { %>
                                <div class="rounded d-flex align-items-center justify-content-center <%= (claim.item && claim.item.type === 'lost') ? 'placeholder-lost' : 'placeholder-found' %>" style="width: 80px; height: 80px;">
                                    <div class="placeholder-icon-wrap placeholder-icon-sm">
                                        <i class="fas <%= (claim.item && claim.item.category && claim.item.category.icon) ? claim.item.category.icon : 'fa-box' %>"></i>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <!-- Claim Info -->
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="mb-1">
                                        <% if (claim.item) { %>
                                            <%= claim.item.itemName %>
                                        <% } else { %>
                                            <span class="text-muted">Item Deleted</span>
                                        <% } %>
                                    </h5>
                                    <p class="text-muted small mb-0">
                                        <i class="fas fa-clock me-1"></i>
                                        Submitted <%= new Date(claim.createdAt).toLocaleDateString() %>
                                    </p>
                                </div>
                                <span class="badge rounded-pill bg-<%= 
                                    claim.status === 'pending' ? 'warning' : 
                                    claim.status === 'under_review' ? 'info' : 
                                    claim.status === 'approved' ? 'success' : 
                                    claim.status === 'rejected' ? 'danger' : 'secondary' 
                                %> <%= claim.status === 'pending' ? 'text-dark' : '' %>">
                                    <% if (claim.status === 'pending') { %>
                                        <i class="fas fa-hourglass-half me-1"></i>Pending
                                    <% } else if (claim.status === 'under_review') { %>
                                        <i class="fas fa-search me-1"></i>Under Review
                                    <% } else if (claim.status === 'approved') { %>
                                        <i class="fas fa-check me-1"></i>Approved
                                    <% } else if (claim.status === 'rejected') { %>
                                        <i class="fas fa-times me-1"></i>Rejected
                                    <% } else { %>
                                        <i class="fas fa-undo me-1"></i>Withdrawn
                                    <% } %>
                                </span>
                            </div>

                            <p class="mb-2 text-truncate" style="max-width: 500px;">
                                <%= claim.description.substring(0, 100) %><%= claim.description.length > 100 ? '...' : '' %>
                            </p>

                            <div class="d-flex gap-2">
                                <a href="/claims/details/<%= claim._id %>" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye me-1"></i>View Details
                                </a>
                                <% if (['pending', 'under_review'].includes(claim.status)) { %>
                                    <form action="/claims/withdraw/<%= claim._id %>" method="POST" class="d-inline" 
                                          onsubmit="return confirm('Are you sure you want to withdraw this claim?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-times me-1"></i>Withdraw
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <% if (claim.status === 'rejected' && claim.rejectionReason) { %>
                        <div class="alert alert-danger small mt-3 mb-0">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Rejection Reason:</strong> <%= claim.rejectionReason %>
                        </div>
                    <% } %>
                </div>
            </div>
        <% }); %>
    <% } %>
</div>

<script>
// Tab filtering for claims
document.querySelectorAll('#claimTabs .nav-link').forEach(btn => {
    btn.addEventListener('click', function() {
        document.querySelectorAll('#claimTabs .nav-link').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        const filter = this.dataset.filter;
        document.querySelectorAll('.claim-card').forEach(card => {
            if (filter === 'all' || card.dataset.status === filter) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    });
});
</script>
