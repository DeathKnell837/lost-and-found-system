<div class="container py-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/claims/my-claims">My Claims</a></li>
            <li class="breadcrumb-item active">Claim Details</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Status Header -->
            <div class="card shadow mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h4 class="mb-1">Claim Request</h4>
                            <p class="text-muted mb-0">
                                Submitted on <%= new Date(claim.createdAt).toLocaleDateString('en-US', { 
                                    weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' 
                                }) %>
                            </p>
                        </div>
                        <span class="badge rounded-pill fs-6 bg-<%= 
                            claim.status === 'pending' ? 'warning' : 
                            claim.status === 'under_review' ? 'info' : 
                            claim.status === 'approved' ? 'success' : 
                            claim.status === 'rejected' ? 'danger' : 'secondary' 
                        %> <%= claim.status === 'pending' ? 'text-dark' : '' %>">
                            <% if (claim.status === 'pending') { %>
                                <i class="fas fa-hourglass-half me-1"></i>Pending Review
                            <% } else if (claim.status === 'under_review') { %>
                                <i class="fas fa-search me-1"></i>Under Review
                            <% } else if (claim.status === 'approved') { %>
                                <i class="fas fa-check-circle me-1"></i>Approved
                            <% } else if (claim.status === 'rejected') { %>
                                <i class="fas fa-times-circle me-1"></i>Rejected
                            <% } else { %>
                                <i class="fas fa-undo me-1"></i>Withdrawn
                            <% } %>
                        </span>
                    </div>

                    <!-- 4-Step Claim Status Stepper -->
                    <div class="claim-stepper-wrap my-4 p-3 rounded-4 bg-light border">
                        <div class="d-flex justify-content-between position-relative claim-stepper">
                            <!-- Step 1 -->
                            <div class="claim-step <%= (claim.status === 'pending' || claim.status === 'under_review' || claim.status === 'approved') ? 'step-completed' : '' %>">
                                <div class="step-icon-circle">
                                    <i class="fas fa-file-signature"></i>
                                </div>
                                <div class="step-label">1. Claim Filed</div>
                                <div class="step-sublabel"><%= new Date(claim.createdAt).toLocaleDateString() %></div>
                            </div>

                            <!-- Step 2 -->
                            <div class="claim-step <%= (claim.status === 'under_review' || claim.status === 'approved') ? 'step-completed' : (claim.status === 'pending' ? 'step-active' : (claim.status === 'rejected' ? 'step-rejected' : '')) %>">
                                <div class="step-icon-circle">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                                <div class="step-label">2. Verification</div>
                                <div class="step-sublabel"><%= claim.status === 'pending' ? 'In Queue' : (claim.status === 'under_review' ? 'Evaluating' : (claim.status === 'approved' ? 'Verified' : 'Closed')) %></div>
                            </div>

                            <!-- Step 3 -->
                            <div class="claim-step <%= claim.status === 'approved' ? 'step-completed' : (claim.status === 'under_review' ? 'step-active' : (claim.status === 'rejected' ? 'step-rejected' : '')) %>">
                                <div class="step-icon-circle">
                                    <i class="fas fa-user-check"></i>
                                </div>
                                <div class="step-label">3. Proof Verified</div>
                                <div class="step-sublabel"><%= claim.status === 'approved' ? 'Confirmed' : 'Security Proof' %></div>
                            </div>

                            <!-- Step 4 -->
                            <div class="claim-step <%= claim.status === 'approved' ? 'step-completed' : (claim.status === 'rejected' ? 'step-rejected' : '') %>">
                                <div class="step-icon-circle">
                                    <i class="fas <%= claim.status === 'rejected' ? 'fa-times' : 'fa-handshake' %>"></i>
                                </div>
                                <div class="step-label">4. Handover &amp; Release</div>
                                <div class="step-sublabel"><%= claim.status === 'approved' ? 'Ready at Office' : (claim.status === 'rejected' ? 'Claim Rejected' : 'Final Step') %></div>
                            </div>
                        </div>
                    </div>

                    <% if (claim.status === 'rejected' && claim.rejectionReason) { %>
                        <div class="alert alert-danger rounded-3">
                            <h6 class="fw-bold"><i class="fas fa-exclamation-circle me-2"></i>Rejection Reason</h6>
                            <p class="mb-0 small"><%= claim.rejectionReason %></p>
                        </div>
                    <% } %>

                    <% if (claim.status === 'approved') { %>
                        <div class="alert alert-success rounded-3 border-success border-opacity-25">
                            <h6 class="fw-bold"><i class="fas fa-check-circle me-2"></i>Claim Approved &amp; Ready for Handover!</h6>
                            <p class="mb-2 small">Congratulations! Your proof of ownership has been verified by campus security.</p>
                            <div class="p-2 rounded bg-white bg-opacity-75 small text-dark">
                                <i class="fas fa-map-marker-alt text-danger me-1"></i> Please visit the <strong>Main Admin Building Ground Floor Security Office</strong> (Mon-Fri 8:00 AM - 6:00 PM) and bring a valid NDMC Student ID to collect your item.
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Your Description -->
            <div class="card shadow mb-4">
                <div class="card-body p-4">
                    <h5 class="mb-3"><i class="fas fa-comment-alt me-2 text-primary"></i>Your Description</h5>
                    <p class="mb-0"><%= claim.description %></p>
                </div>
            </div>

            <!-- Proof of Ownership -->
            <div class="card shadow mb-4">
                <div class="card-body p-4">
                    <h5 class="mb-3"><i class="fas fa-certificate me-2 text-success"></i>Proof of Ownership</h5>
                    <p><%= claim.proofOfOwnership %></p>

                    <% if (claim.identifyingFeatures) { %>
                        <h6 class="mt-4 mb-2">Identifying Features</h6>
                        <p class="mb-0"><%= claim.identifyingFeatures %></p>
                    <% } %>

                    <% if (claim.proofImages && claim.proofImages.length > 0) { %>
                        <h6 class="mt-4 mb-2">Uploaded Proof Images</h6>
                        <div class="d-flex gap-2 flex-wrap">
                            <% claim.proofImages.forEach(img => { %>
                                <img src="<%= img.url %>" class="rounded" 
                                     style="width: 100px; height: 100px; object-fit: cover; cursor: pointer;" 
                                     onclick="window.open('<%= img.url %>')">
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Timeline -->
            <div class="card shadow">
                <div class="card-body p-4">
                    <h5 class="mb-4"><i class="fas fa-history me-2 text-info"></i>Timeline</h5>
                    <div class="timeline">
                        <% if (claim.timeline && claim.timeline.length > 0) { %>
                            <% claim.timeline.slice().reverse().forEach(event => { %>
                                <div class="timeline-item" style="position: relative; padding-left: 30px; padding-bottom: 20px; border-left: 2px solid #dee2e6;">
                                    <div style="position: absolute; left: -8px; top: 0; width: 14px; height: 14px; border-radius: 50%; background: #6c5ce7; border: 2px solid white;"></div>
                                    <div>
                                        <strong><%= event.action %></strong>
                                        <p class="text-muted small mb-0">
                                            <%= new Date(event.timestamp).toLocaleString() %>
                                            <% if (event.performedBy) { %>
                                                by <%= event.performedBy.username || 'System' %>
                                            <% } %>
                                        </p>
                                        <% if (event.note) { %>
                                            <p class="small mt-1 mb-0"><%= event.note %></p>
                                        <% } %>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="timeline-item" style="position: relative; padding-left: 30px; border-left: 2px solid transparent;">
                                <div style="position: absolute; left: -8px; top: 0; width: 14px; height: 14px; border-radius: 50%; background: #6c5ce7; border: 2px solid white;"></div>
                                <div>
                                    <strong>Claim Submitted</strong>
                                    <p class="text-muted small mb-0"><%= new Date(claim.createdAt).toLocaleString() %></p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar - Item Info -->
        <div class="col-lg-4">
            <div class="card shadow position-sticky mb-4" style="top: 80px;">
                <div class="card-body">
                    <h6 class="text-muted mb-3">
                        <i class="fas fa-box me-2"></i>Item Being Claimed
                    </h6>
                    
                    <% if (claim.item) { %>
                        <% if (claim.item.imagePath) { %>
                            <img src="<%= claim.item.imagePath %>" alt="" class="w-100 rounded mb-3" style="max-height: 300px; object-fit: cover;">
                        <% } %>
                        
                        <h5><%= claim.item.itemName %></h5>
                        <p class="text-muted small mb-2">
                            <i class="fas fa-map-marker-alt me-1"></i><%= claim.item.location %>
                        </p>
                        <p class="small"><%= claim.item.description ? claim.item.description.substring(0, 150) + '...' : 'No description' %></p>
                        
                        <a href="/items/<%= claim.item._id %>" class="btn btn-outline-primary btn-sm w-100" target="_blank">
                            <i class="fas fa-external-link-alt me-1"></i>View Item
                        </a>
                    <% } else { %>
                        <div class="text-center text-muted py-3">
                            <i class="fas fa-trash fa-2x mb-2"></i>
                            <p class="mb-0">Item has been deleted</p>
                        </div>
                    <% } %>

                    <hr>

                    <h6 class="text-muted mb-3">
                        <i class="fas fa-phone me-2"></i>Contact Details
                    </h6>
                    <p class="small mb-1">
                        <strong>Email:</strong> <%= claim.claimant.email %>
                    </p>
                    <% if (claim.contactPhone) { %>
                        <p class="small mb-1">
                            <strong>Phone:</strong> <%= claim.contactPhone %>
                        </p>
                    <% } %>
                    <p class="small mb-0">
                        <strong>Preferred:</strong> <%= claim.preferredContactMethod %>
                    </p>

                    <% if (['pending', 'under_review'].includes(claim.status)) { %>
                        <hr>
                        <form action="/claims/withdraw/<%= claim._id %>" method="POST" 
                              onsubmit="return confirm('Are you sure you want to withdraw this claim?')">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="fas fa-times me-1"></i>Withdraw Claim
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
