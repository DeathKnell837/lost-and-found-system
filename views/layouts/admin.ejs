<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Admin - Lost & Found' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/css/admin.css?v=<%= Date.now() %>">
    <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="admin-body">
    <% if (typeof admin !== 'undefined' && admin) { %>
        <%- include('../partials/admin-sidebar') %>
    <% } %>
    
    <div class="admin-content <%= (typeof admin !== 'undefined' && admin) ? 'with-sidebar' : '' %>">
        <% if (typeof admin !== 'undefined' && admin) { %>
            <%- include('../partials/admin-header') %>
        <% } %>
        
        <main class="admin-main">
            <%- include('../partials/flash') %>
            <%- body %>
        </main>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/admin.js?v=<%= Date.now() %>"></script>
    <%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
